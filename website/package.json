{
  "name": "entaris-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website pemasaran Entaris — Agentic Reasoning System (PT Arah Karya Sinergi)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
