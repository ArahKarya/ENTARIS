model GaBranch {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  address     String?
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  costCenters GaCostCenter[]
  assets      GaAsset[]
  locations   GaLocation[]

  @@map("ga_branches")
}

model GaCostCenter {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  branchId String    @map("branch_id")
  isActive Boolean   @default(true) @map("is_active")
  branch   GaBranch  @relation(fields: [branchId], references: [id])
  assets   GaAsset[]
  paymentRequests     PaymentRequest[]     @relation("PaymentRequestCostCenter")
  paymentRequestLines PaymentRequestLine[] @relation("PaymentRequestLineCostCenter")

  @@index([branchId])
  @@map("ga_cost_centers")
}

model GaAssetCategory {
  id                         String    @id @default(cuid())
  code                       String    @unique
  name                       String
  customFieldsSchema         Json?     @map("custom_fields_schema")
  maintenanceChecklistSchema Json?     @map("maintenance_checklist_schema")
  isActive                   Boolean   @default(true) @map("is_active")
  assets                     GaAsset[]

  @@map("ga_asset_categories")
}

model GaAsset {
  id                           String                    @id @default(cuid())
  code                         String                    @unique
  name                         String
  categoryId                   String                    @map("category_id")
  branchId                     String                    @map("branch_id")
  costCenterId                 String?                   @map("cost_center_id")
  picUserId                    String?                   @map("pic_user_id")
  serialNumber                 String?                   @map("serial_number")
  acquisitionDate              DateTime?                 @map("acquisition_date")
  acquisitionCost              Decimal?                  @map("acquisition_cost") @db.Decimal(18, 2)
  status                       GaAssetStatus             @default(ACTIVE)
  condition                    GaAssetCondition          @default(GOOD)
  location                     String?
  notes                        String?
  customFields                 Json?                     @map("custom_fields")
  maintenanceChecklistOverride Json?                     @map("maintenance_checklist_override")
  createdAt                    DateTime                  @default(now()) @map("created_at")
  updatedAt                    DateTime                  @updatedAt @map("updated_at")
  category                     GaAssetCategory           @relation(fields: [categoryId], references: [id])
  branch                       GaBranch                  @relation(fields: [branchId], references: [id])
  costCenter                   GaCostCenter?             @relation(fields: [costCenterId], references: [id])
  photos                       GaAssetPhoto[]
  qr                           GaAssetQr?
  documents                    GaDocument[]
  maintenanceSchedules         GaMaintenanceSchedule[]
  workOrders                   GaWorkOrder[]
  vehicleData                  GaVehicleData?
  vehicleServiceLogs           GaVehicleServiceLog[]
  vehicleServiceRequests       GaVehicleServiceRequest[]
  buildingData                 GaBuildingData?
  buildingRentals              GaBuildingRental[]
  equipmentData                GaEquipmentData?
  fixedAsset                   FixedAsset?               @relation("FixedAssetEam")
  calibrationLogs              GaCalibrationLog[]
  materialRequests             GaMaterialRequest[]
  vehicleTaxes                 GaVehicleTax[]
  vehicleTaxRequests           GaVehicleTaxRequest[]
  vehicleInsurances            GaVehicleInsurance[]
  vehicleFuelLogs              GaVehicleFuelLog[]
  vehicleInspections           GaVehicleInspection[]
  vehicleIncidents             GaVehicleIncident[]
  vehicleTires                 GaVehicleTire[]
  vehicleOilLogs               GaVehicleOilLog[]

  @@index([categoryId])
  @@index([branchId])
  @@index([picUserId])
  @@index([status])
  @@map("ga_assets")
}

model GaAssetPhoto {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  filePath  String   @map("file_path")
  caption   String?
  orderIdx  Int      @default(0) @map("order_idx")
  createdAt DateTime @default(now()) @map("created_at")
  asset     GaAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("ga_asset_photos")
}

model GaAssetQr {
  id        String   @id @default(cuid())
  assetId   String   @unique @map("asset_id")
  qrCode    String   @unique @map("qr_code")
  createdAt DateTime @default(now()) @map("created_at")
  asset     GaAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("ga_asset_qrs")
}

model GaDocumentType {
  id                 String       @id @default(cuid())
  code               String       @unique
  name               String
  category           String?
  customFieldsSchema Json?        @map("custom_fields_schema")
  isActive           Boolean      @default(true) @map("is_active")
  documents          GaDocument[]

  @@map("ga_document_types")
}

model GaDocument {
  id                String               @id @default(cuid())
  code              String               @unique
  title             String
  typeId            String               @map("type_id")
  assetId           String?              @map("asset_id")
  issuedBy          String?              @map("issued_by")
  issuedNumber      String?              @map("issued_number")
  effectiveDate     DateTime?            @map("effective_date")
  expiryDate        DateTime?            @map("expiry_date")
  status            GaDocumentStatus     @default(ACTIVE)
  customFields      Json?                @map("custom_fields")
  createdBy         String?              @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  type              GaDocumentType       @relation(fields: [typeId], references: [id])
  asset             GaAsset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  versions          GaDocumentVersion[]
  buildingRentals   GaBuildingRental[]
  calibrationLog    GaCalibrationLog?
  vehicleTaxes      GaVehicleTax[]
  vehicleInsurances GaVehicleInsurance[]

  @@index([typeId])
  @@index([assetId])
  @@index([expiryDate])
  @@index([status])
  @@map("ga_documents")
}

model GaDocumentVersion {
  id         String     @id @default(cuid())
  documentId String     @map("document_id")
  versionNo  Int        @map("version_no")
  filePath   String     @map("file_path")
  fileSize   Int        @map("file_size")
  uploadedBy String     @map("uploaded_by")
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  document   GaDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@map("ga_document_versions")
}

model GaInventoryCategory {
  id    String            @id @default(cuid())
  code  String            @unique
  name  String
  type  GaInventoryType
  items GaInventoryItem[]

  @@map("ga_inventory_categories")
}

model GaLocation {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  name                 String
  branchId             String                  @map("branch_id")
  branch               GaBranch                @relation(fields: [branchId], references: [id])
  stocks               GaStockByLocation[]
  movsFrom             GaInventoryMovement[]   @relation("GaMovFrom")
  movsTo               GaInventoryMovement[]   @relation("GaMovTo")
  workOrderParts       GaWorkOrderPart[]
  materialRequestItems GaMaterialRequestItem[]

  @@index([branchId])
  @@map("ga_locations")
}

model GaInventoryItem {
  id                   String                  @id @default(cuid())
  sku                  String                  @unique
  name                 String
  categoryId           String                  @map("category_id")
  uom                  String
  minStock             Decimal                 @default(0) @map("min_stock") @db.Decimal(12, 2)
  imagePath            String?                 @map("image_path")
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @map("created_at")
  category             GaInventoryCategory     @relation(fields: [categoryId], references: [id])
  stocks               GaStockByLocation[]
  movements            GaInventoryMovement[]
  workOrderParts       GaWorkOrderPart[]
  materialRequestItems GaMaterialRequestItem[]

  @@index([categoryId])
  @@map("ga_inventory_items")
}

model GaStockByLocation {
  id         String          @id @default(cuid())
  itemId     String          @map("item_id")
  locationId String          @map("location_id")
  quantity   Decimal         @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime        @updatedAt @map("updated_at")
  item       GaInventoryItem @relation(fields: [itemId], references: [id])
  location   GaLocation      @relation(fields: [locationId], references: [id])

  @@unique([itemId, locationId])
  @@index([itemId])
  @@map("ga_stock_by_location")
}

model GaInventoryMovement {
  id             String           @id @default(cuid())
  itemId         String           @map("item_id")
  type           GaMovementType
  quantity       Decimal          @db.Decimal(12, 2)
  fromLocationId String?          @map("from_location_id")
  toLocationId   String?          @map("to_location_id")
  referenceNo    String?          @map("reference_no")
  notes          String?
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  item           GaInventoryItem  @relation(fields: [itemId], references: [id])
  fromLocation   GaLocation?      @relation("GaMovFrom", fields: [fromLocationId], references: [id])
  toLocation     GaLocation?      @relation("GaMovTo", fields: [toLocationId], references: [id])
  workOrderPart  GaWorkOrderPart?

  @@index([itemId])
  @@index([createdAt])
  @@map("ga_inventory_movements")
}

model GaMaintenanceSchedule {
  id            String        @id @default(cuid())
  assetId       String        @map("asset_id")
  intervalDays  Int?          @map("interval_days")
  intervalHours Int?          @map("interval_hours")
  intervalKm    Int?          @map("interval_km")
  lastDoneAtKm  Int?          @map("last_done_at_km")
  nextDueAtKm   Int?          @map("next_due_at_km")
  nextDueAt     DateTime      @map("next_due_at")
  lastDoneAt    DateTime?     @map("last_done_at")
  isActive      Boolean       @default(true) @map("is_active")
  notes         String?
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  asset         GaAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrders    GaWorkOrder[]

  @@index([assetId])
  @@index([nextDueAt, isActive])
  @@map("ga_maintenance_schedules")
}

model GaWorkOrder {
  id                String                   @id @default(cuid())
  code              String                   @unique
  assetId           String                   @map("asset_id")
  type              GaWorkOrderType
  status            GaWorkOrderStatus        @default(OPEN)
  priority          GaWorkOrderPriority      @default(MEDIUM)
  title             String
  description       String?
  reportedById      String?                  @map("reported_by_id")
  reportedAt        DateTime                 @default(now()) @map("reported_at")
  assignedToId      String?                  @map("assigned_to_id")
  assignedAt        DateTime?                @map("assigned_at")
  assignedById      String?                  @map("assigned_by_id")
  startedAt         DateTime?                @map("started_at")
  completedAt       DateTime?                @map("completed_at")
  completedById     String?                  @map("completed_by_id")
  resolution        String?
  wasLate           Boolean                  @default(false) @map("was_late")
  closedAt          DateTime?                @map("closed_at")
  closedById        String?                  @map("closed_by_id")
  cancelledAt       DateTime?                @map("cancelled_at")
  cancelledById     String?                  @map("cancelled_by_id")
  cancelReason      String?                  @map("cancel_reason")
  scheduleId        String?                  @map("schedule_id")
  dueAt             DateTime?                @map("due_at")
  laborHours        Decimal?                 @map("labor_hours") @db.Decimal(6, 2)
  laborCost         Decimal?                 @map("labor_cost") @db.Decimal(14, 2)
  externalVendor    String?                  @map("external_vendor")
  externalCost      Decimal?                 @map("external_cost") @db.Decimal(14, 2)
  component         String?
  checklist         Json?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  asset             GaAsset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schedule          GaMaintenanceSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  photos            GaWorkOrderPhoto[]
  parts             GaWorkOrderPart[]
  materialRequests  GaMaterialRequest[]
  vehicleServiceLog GaVehicleServiceLog?
  vehicleServiceReq GaVehicleServiceRequest?
  calibrationLog    GaCalibrationLog?

  @@index([assetId])
  @@index([status])
  @@index([assignedToId])
  @@index([scheduleId])
  @@index([dueAt])
  @@map("ga_work_orders")
