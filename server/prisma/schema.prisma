model FixedAsset {
  id                      String              @id @default(uuid())
  assetNumber             String              @unique @map("asset_number")
  // Link ke master aset EAM (ga_assets). Aset EAM = master tunggal;
  // FixedAsset = profil keuangan/penyusutan yang menempel.
  gaAssetId               String?             @unique @map("ga_asset_id")
  gaAsset                 GaAsset?            @relation("FixedAssetEam", fields: [gaAssetId], references: [id])
  name                    String
  category                String
  description             String?
  acquisitionDate         DateTime            @map("acquisition_date")
  acquisitionCost         Decimal             @map("acquisition_cost") @db.Decimal(20, 2)
  usefulLifeMonths        Int                 @map("useful_life_months")
  salvageValue            Decimal             @default(0) @map("salvage_value") @db.Decimal(20, 2)
  depreciationMethod      String              @default("straight_line") @map("depreciation_method")
  accumulatedDepreciation Decimal             @default(0) @map("accumulated_depreciation") @db.Decimal(20, 2)
  bookValue               Decimal             @map("book_value") @db.Decimal(20, 2)
  status                  String              @default("Active")
  disposalDate            DateTime?           @map("disposal_date")
  disposalAmount          Decimal?            @map("disposal_amount") @db.Decimal(20, 2)
  assetAccountId          String              @map("asset_account_id")
  assetAccount            Account             @relation("AssetAccount", fields: [assetAccountId], references: [id])
  depreciationAccountId   String              @map("depreciation_account_id")
  depreciationAccount     Account             @relation("DepreciationAccount", fields: [depreciationAccountId], references: [id])
  accumulatedDepAccountId String              @map("accumulated_dep_account_id")
  accumulatedDepAccount   Account             @relation("AccumulatedDepAccount", fields: [accumulatedDepAccountId], references: [id])
  fiscalYearId            String              @map("fiscal_year_id")
  fiscalYear              FiscalYear          @relation(fields: [fiscalYearId], references: [id])
  createdBy               String              @map("created_by")
  user                    User                @relation("AssetCreatedBy", fields: [createdBy], references: [id])
  depreciationEntries     DepreciationEntry[]
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id             String        @id @default(uuid())
  fixedAssetId   String        @map("fixed_asset_id")
  fixedAsset     FixedAsset    @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  periodDate     DateTime      @map("period_date")
  amount         Decimal       @db.Decimal(20, 2)
  journalEntryId String?       @map("journal_entry_id")
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  isPosted       Boolean       @default(false) @map("is_posted")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([fixedAssetId])
  @@index([periodDate])
  @@map("depreciation_entries")
}

model ApprovalRule {
  id           String   @id @default(uuid())
  documentType String   @map("document_type")
  minAmount    Decimal  @default(0) @map("min_amount") @db.Decimal(20, 2)
  requiredRole String   @map("required_role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([documentType])
  @@map("approval_rules")
}

model ApprovalRequest {
  id             String    @id @default(uuid())
  documentType   String    @map("document_type")
  // Null sampai disetujui — utk gate "approve-before-effect", dokumen baru
  // dibuat saat approve. payload menyimpan body submit asli.
  documentId     String?   @map("document_id")
  documentNumber String?   @map("document_number")
  amount         Decimal?  @db.Decimal(20, 2)
  payload        Json?
  status         String    @default("Pending")
  requestedBy    String    @map("requested_by")
  requester      User      @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  approvedBy     String?   @map("approved_by")
  approver       User?     @relation("ApprovalApprover", fields: [approvedBy], references: [id])
  rejectedBy     String?   @map("rejected_by")
  rejecter       User?     @relation("ApprovalRejecter", fields: [rejectedBy], references: [id])
  notes          String?
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([documentType, documentId])
  @@index([status])
  @@index([requestedBy])
  @@map("approval_requests")
}

// COGS Backfill Queue
// Tracks pending COGS adjustments for sales invoices posted with negative stock.
// Settled FIFO when matching inventory replenishes (purchase / production / adjustment).
model CogsBackfillQueue {
  id                 String                   @id @default(uuid())
  salesInvoiceId     String                   @map("sales_invoice_id")
  salesInvoice       SalesInvoice             @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  salesInvoiceItemId String                   @map("sales_invoice_item_id")
  salesInvoiceItem   SalesInvoiceItem         @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)
  inventoryItemId    String                   @map("inventory_item_id")
  inventoryItem      InventoryItem            @relation("CogsBackfillItem", fields: [inventoryItemId], references: [id])
  qtyPending         Decimal                  @map("qty_pending") @db.Decimal(15, 3)
  qtyOriginal        Decimal                  @map("qty_original") @db.Decimal(15, 3)
  costAtSale         Decimal                  @map("cost_at_sale") @db.Decimal(20, 2)
  status             String                   @default("Pending") // Pending / PartiallySettled / Settled
  fiscalYearId       String                   @map("fiscal_year_id")
  fiscalYear         FiscalYear               @relation("CogsBackfillFY", fields: [fiscalYearId], references: [id])
  settlements        CogsBackfillSettlement[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  settledAt          DateTime?                @map("settled_at")

  @@index([status])
  @@index([inventoryItemId, status])
  @@index([salesInvoiceId])
  @@index([createdAt])
  @@map("cogs_backfill_queue")
}

model CogsBackfillSettlement {
  id             String            @id @default(uuid())
  queueId        String            @map("queue_id")
  queue          CogsBackfillQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  qtySettled     Decimal           @map("qty_settled") @db.Decimal(15, 3)
  costAtSettle   Decimal           @map("cost_at_settle") @db.Decimal(20, 2)
  differential   Decimal           @db.Decimal(20, 2)
  journalEntryId String?           @map("journal_entry_id")
  journalEntry   JournalEntry?     @relation("CogsBackfillJE", fields: [journalEntryId], references: [id])
  triggerSource  String            @map("trigger_source") // PurchaseInvoice / ProductionRun / StockMovement
  triggerRefId   String?           @map("trigger_ref_id")
  triggerRefNo   String?           @map("trigger_ref_no")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([queueId])
  @@index([journalEntryId])
  @@map("cogs_backfill_settlements")
}

// Purchase Order (PO)
// Pemesanan ke supplier. Tidak ada GL impact, tidak ada stok impact.
// partyId nullable → "PO Umum" (boleh dipenuhi supplier mana saja). Kalau
// di-set → "PO Khusus" terikat ke supplier itu.
model PurchaseOrder {
  id                   String              @id @default(uuid())
  poNumber             String              @unique @map("po_number")
  date                 DateTime
  partyId              String?             @map("party_id")
  supplier             Party?              @relation("PurchaseOrderSupplier", fields: [partyId], references: [id])
  status               DocumentStatus      @default(Submitted)
  notes                String?
  terms                String?
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  totalEstimated       Decimal             @default(0) @map("total_estimated") @db.Decimal(15, 2)
  // Pricing lives in services/purchaseOrderCalc.ts. totalEstimated = grandTotal.
  subtotal             Decimal             @default(0) @db.Decimal(15, 2)
  discountTotal        Decimal             @default(0) @map("discount_total") @db.Decimal(15, 2)
  taxTotal             Decimal             @default(0) @map("tax_total") @db.Decimal(15, 2)
  otherCosts           Decimal             @default(0) @map("other_costs") @db.Decimal(15, 2)
  otherCostsLabel      String?             @map("other_costs_label")
  grandTotal           Decimal             @default(0) @map("grand_total") @db.Decimal(15, 2)
  paymentTermDays      Int?                @map("payment_term_days")
  warehouseId          String?             @map("warehouse_id")
  warehouse            Warehouse?          @relation("PurchaseOrderWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  supplierQuoteRef     String?             @map("supplier_quote_ref")
  // Approval (status stays Draft while pending): null | 'Pending' | 'Rejected'.
  approvalStatus       String?             @map("approval_status")
  approvalNote         String?             @map("approval_note")
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]      @relation("GRFromPO")
  purchaseInvoices     PurchaseInvoice[]   @relation("PIFromPO")
  fiscalYearId         String              @map("fiscal_year_id")
  fiscalYear           FiscalYear          @relation("PurchaseOrderFY", fields: [fiscalYearId], references: [id])
  createdBy            String              @map("created_by")
  user                 User                @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  submittedAt          DateTime?           @map("submitted_at")
  cancelledAt          DateTime?           @map("cancelled_at")
  // Short-close ("Tutup PO"): status tetap Submitted, sisa qty tidak lagi diharapkan.
  closedAt             DateTime?           @map("closed_at")
  closeReason          String?             @map("close_reason")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([fiscalYearId])
  @@index([warehouseId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String             @id @default(uuid())
  purchaseOrderId   String             @map("purchase_order_id")
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId   String?            @map("inventory_item_id")
  inventoryItem     InventoryItem?     @relation("POItemInventory", fields: [inventoryItemId], references: [id])
  itemName          String             @map("item_name")
  quantity          Decimal            @db.Decimal(15, 3)
  unit              String
  estimatedRate     Decimal            @default(0) @map("estimated_rate") @db.Decimal(15, 2)
  estimatedAmount   Decimal            @default(0) @map("estimated_amount") @db.Decimal(15, 2)
  discount          Decimal            @default(0) @db.Decimal(5, 2) // %
  taxPct            Decimal            @default(0) @map("tax_pct") @db.Decimal(5, 2) // PPN %
  taxAmount         Decimal            @default(0) @map("tax_amount") @db.Decimal(15, 2)
  // Denormalized counter — bumped when STT items reference this PO item.
  qtyReceived       Decimal            @default(0) @map("qty_received") @db.Decimal(15, 3)
  description       String?
  goodsReceiptItems GoodsReceiptItem[] @relation("GRItemFromPOItem")

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_items")
}

// Goods Receipt (STT / BPB)
// Bukti Penerimaan Barang. Tempat stok physically masuk gudang (bukan lagi
// di PurchaseInvoice). Bisa standalone tanpa PO. Bisa di-invoice nanti via PI.
model GoodsReceipt {
  id               String             @id @default(uuid())
  sttNumber        String             @unique @map("stt_number")
  date             DateTime
  partyId          String             @map("party_id")
  supplier         Party              @relation("GoodsReceiptSupplier", fields: [partyId], references: [id])
  // Barang titipan pelanggan (jasa repros/maklon): qty tracked, nilai GL
  // dipaksa 0, disembunyikan dari picker PI, averageCost item tak disentuh.
  isCustomerOwned  Boolean            @default(false) @map("is_customer_owned")
  // Optional link ke PO (kalau STT memang dipenuhi dari PO tertentu).
  purchaseOrderId  String?            @map("purchase_order_id")
  purchaseOrder    PurchaseOrder?     @relation("GRFromPO", fields: [purchaseOrderId], references: [id])
  status           DocumentStatus     @default(Submitted)
  notes            String?
  // Physical-delivery metadata (untuk dicetak di BPB)
  nomorMobil       String?            @map("nomor_mobil")
  driverName       String?            @map("driver_name")
  recipientName    String?            @map("recipient_name")
  // PI linkage — set ketika items difold ke invoice. 1 STT → 1 PI aktif.
  invoiceId        String?            @map("invoice_id")
  invoice          PurchaseInvoice?   @relation("PIFromGR", fields: [invoiceId], references: [id])
  invoicedAt       DateTime?          @map("invoiced_at")
  // True kalau record ini dibuat via backfill script untuk PI legacy.
  // Bedakan dari STT real supaya audit + UI bisa kasih badge yang sesuai.
  isLegacyBackfill Boolean            @default(false) @map("is_legacy_backfill")
  items            GoodsReceiptItem[]
  fiscalYearId     String             @map("fiscal_year_id")
  fiscalYear       FiscalYear         @relation("GoodsReceiptFY", fields: [fiscalYearId], references: [id])
  createdBy        String             @map("created_by")
  user             User               @relation("GoodsReceiptCreator", fields: [createdBy], references: [id])
  submittedAt      DateTime?          @map("submitted_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([purchaseOrderId])
  @@index([fiscalYearId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String               @id @default(uuid())
  goodsReceiptId      String               @map("goods_receipt_id")
  goodsReceipt        GoodsReceipt         @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  inventoryItemId     String               @map("inventory_item_id")
  inventoryItem       InventoryItem        @relation("GRItemInventory", fields: [inventoryItemId], references: [id])
  warehouseId         String               @map("warehouse_id")
  warehouse           Warehouse            @relation("GRItemWarehouse", fields: [warehouseId], references: [id])
  itemName            String               @map("item_name")
  quantity            Decimal              @db.Decimal(15, 3)
  unit                String
  // Harga kontrak/estimasi saat barang diterima. Locked ke movement supaya
  // average cost & COGS proper. PI nanti bisa kasih harga berbeda → variance
  // posted ke "Selisih Harga Pembelian".
  lockedUnitCost      Decimal              @default(0) @map("locked_unit_cost") @db.Decimal(20, 2)
  description         String?
  // Optional link ke baris PO yang dipenuhi.
  purchaseOrderItemId String?              @map("purchase_order_item_id")
  purchaseOrderItem   PurchaseOrderItem?   @relation("GRItemFromPOItem", fields: [purchaseOrderItemId], references: [id])
  // Stock movement In yang dibuat saat STT submit. UNIQUE — tiap baris STT
  // hanya boleh punya 1 SM aktif.
  stockMovementId     String?              @unique @map("stock_movement_id")
  stockMovement       StockMovement?       @relation("GRLineMovement", fields: [stockMovementId], references: [id])
  // Back-relation: baris PI yang mengambil baris STT ini untuk di-invoice.
  invoiceItem         PurchaseInvoiceItem? @relation("PILineFromGRLine")

  @@index([goodsReceiptId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_items")
}

// Retur Penjualan (Sales Return / Credit Note)
// Dokumen retur yang me-refer ke satu SalesInvoice. Submit memposting:
//   - JE kontra-revenue (DR 4.3 Retur Penjualan + DR PPN Keluaran / CR Piutang
//     + CR Uang Muka Pelanggan utk sisa kredit)
//   - opsional stok masuk balik + balik HPP (DR Persediaan / CR HPP) per baris
//     yang restock=true
// Bukan mengubah InvoiceStatus — status retur dilacak di dokumen ini sendiri.
model SalesReturn {
  id                  String            @id @default(uuid())
  returnNumber        String            @unique @map("return_number")
  date                DateTime
  partyId             String            @map("party_id")
  customer            Party             @relation(fields: [partyId], references: [id])
  salesInvoiceId      String            @map("sales_invoice_id")
  salesInvoice        SalesInvoice      @relation(fields: [salesInvoiceId], references: [id])
  status              String            @default("Submitted")
  subtotal            Decimal           @db.Decimal(15, 2)
  taxAmount           Decimal           @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalReturn         Decimal           @map("total_return") @db.Decimal(15, 2)
  // Split: berapa yang mengurangi piutang vs jadi kredit (uang muka) pelanggan.
  arReducedAmount     Decimal           @default(0) @map("ar_reduced_amount") @db.Decimal(15, 2)
  creditCreatedAmount Decimal           @default(0) @map("credit_created_amount") @db.Decimal(15, 2)
  // Payment (CustomerDeposit) yang dibuat untuk porsi kredit. Plain scalar.
  customerDepositId   String?           @map("customer_deposit_id")
  reason              String?
  notes               String?
  fiscalYearId        String            @map("fiscal_year_id")
  createdBy           String            @map("created_by")
  items               SalesReturnItem[]
  submittedAt         DateTime?         @map("submitted_at")
  cancelledAt         DateTime?         @map("cancelled_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([salesInvoiceId])
  @@index([status])
  @@index([date])
  @@map("sales_returns")
}

model SalesReturnItem {
  id                 String           @id @default(uuid())
  salesReturnId      String           @map("sales_return_id")
  salesReturn        SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  // Baris invoice asal — sumber harga & guard anti over-retur.
  salesInvoiceItemId String           @map("sales_invoice_item_id")
  salesInvoiceItem   SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id])
  // Scalar (tanpa relation) supaya tak menambah back-relation di banyak model.
  inventoryItemId    String?          @map("inventory_item_id")
  warehouseId        String?          @map("warehouse_id")
  accountId          String           @map("account_id")
  itemName           String           @map("item_name")
  quantity           Decimal          @db.Decimal(15, 3)
  unit               String
  rate               Decimal          @db.Decimal(15, 2)
  discount           Decimal          @default(0) @db.Decimal(5, 2)
  amount             Decimal          @db.Decimal(15, 2)
  taxPct             Decimal          @default(0) @map("tax_pct") @db.Decimal(5, 2)
  // true = barang masuk stok kembali (layak jual) + balik HPP; false = rusak.
  restock            Boolean          @default(true)
  // Cost HPP asli (dari DO stockMovement / unitCostLoaded / averageCost).
  unitCostLoaded     Decimal?         @map("unit_cost_loaded") @db.Decimal(20, 4)
  // StockMovement In yang dibuat bila restock. Plain scalar.
  stockMovementId    String?          @map("stock_movement_id")

  @@index([salesReturnId])
  @@index([salesInvoiceItemId])
  @@map("sales_return_items")
}

// Uang Jaminan Proyek (Project Guarantee)
// Deposit: DR Uang Jaminan (1.8) / CR Kas-Bank. Settlement (partial, repeatable): DR Kas-Bank
// (returned) + DR Beban (forfeited) / CR Uang Jaminan. outstanding = amount - active settlements.
// JE/ALE lines carry no partyId on purpose, or applyPartyImpact would raise the party's outstanding.
model ProjectGuarantee {
  id                 String                       @id @default(uuid())
  guaranteeNumber    String                       @unique @map("guarantee_number")
  date               DateTime
  partyId            String                       @map("party_id")
  party              Party                        @relation("ProjectGuaranteeParty", fields: [partyId], references: [id])
  // Penawaran | Pelaksanaan | Pemeliharaan | Lainnya — divalidasi Zod, bukan enum.
  guaranteeType      String                       @map("guarantee_type")
  projectName        String                       @map("project_name")
  referenceNo        String?                      @map("reference_no")
  amount             Decimal                      @db.Decimal(15, 2)
  // Akun kas/bank sumber dana. Plain scalar.
  accountId          String                       @map("account_id")
  expectedReturnDate DateTime?                    @map("expected_return_date")
  notes              String?
  // Disetor | Selesai | Dibatalkan
  status             String                       @default("Disetor")
  journalEntryId     String?                      @map("journal_entry_id")
  fiscalYearId       String                       @map("fiscal_year_id")
  createdBy          String                       @map("created_by")
  settlements        ProjectGuaranteeSettlement[]
  submittedAt        DateTime?                    @map("submitted_at")
  cancelledAt        DateTime?                    @map("cancelled_at")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([expectedReturnDate])
  @@index([fiscalYearId])
  @@map("project_guarantees")
}

model ProjectGuaranteeSettlement {
  id               String           @id @default(uuid())
  guaranteeId      String           @map("guarantee_id")
  guarantee        ProjectGuarantee @relation(fields: [guaranteeId], references: [id])
  date             DateTime
  returnAmount     Decimal          @default(0) @map("return_amount") @db.Decimal(15, 2)
  forfeitAmount    Decimal          @default(0) @map("forfeit_amount") @db.Decimal(15, 2)
  // Kas/bank tujuan pengembalian. Plain scalar.
  returnAccountId  String?          @map("return_account_id")
  // Akun beban utk porsi hangus. Plain scalar.
  forfeitAccountId String?          @map("forfeit_account_id")
  journalEntryId   String?          @map("journal_entry_id")
  notes            String?
  isCancelled      Boolean          @default(false) @map("is_cancelled")
  cancelledAt      DateTime?        @map("cancelled_at")
  createdBy        String           @map("created_by")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([guaranteeId])
  @@map("project_guarantee_settlements")
}

// Konfigurasi Notifikasi Telegram (singleton)
// Diisi lewat UI Settings (Admin). bot_token = secret: write-only dari UI
// (GET tak pernah mengembalikannya). Pengiriman pesan: services/telegramService.
model TelegramConfig {
  id                   String   @id @default(uuid())
  slug                 String   @unique @default("default")
  enabled              Boolean  @default(false)
  botToken             String?  @map("bot_token")
  chatId               String?  @map("chat_id")
  notifyApproval       Boolean  @default(true) @map("notify_approval")
  notifyInvoiceOverdue Boolean  @default(true) @map("notify_invoice_overdue")
  notifyLowStock       Boolean  @default(true) @map("notify_low_stock")
  // Japri per-user: master toggle + offset polling getUpdates.
  personalEnabled      Boolean  @default(true) @map("personal_enabled")
  lastUpdateId         BigInt?  @map("last_update_id")
  updatedBy            String?  @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("telegram_config")
}

// State sementara alur "Minta Revisi" via Telegram (2 langkah)
// Saat admin tekan tombol Minta Revisi, simpan request yg ditunggu alasannya;
// balasan teks berikutnya di chat tsb jadi alasan revisi. Lihat telegramService.
model TelegramPendingRevise {
  chatId      String   @id @map("chat_id")
  requestId   String   @map("request_id")
  actorUserId String   @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("telegram_pending_revise")
}

