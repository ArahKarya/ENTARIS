  // Body CreateProductionRunSchema apa adanya (seluruh isian modal).
  payload           Json
  // Draft | PendingApproval | Posted | Discarded
  status            String    @default("Draft")
  createdById       String    @map("created_by_id")
  updatedById       String?   @map("updated_by_id")
  postedRunId       String?   @map("posted_run_id")
  postedRunNumber   String?   @map("posted_run_number")
  postedAt          DateTime? @map("posted_at")
  postedById        String?   @map("posted_by_id")
  approvalRequestId String?   @map("approval_request_id")
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

