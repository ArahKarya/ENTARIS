  @@index([createdById])
  @@index([approvalRequestId])
  @@map("production_run_drafts")
}

/// Draft Buku Kas (dari nota / halaman buku kas). Tidak berefek ke GL sampai diposting.
model CashBookDraft {
  id             String             @id @default(uuid())
  draftNumber    String             @unique @map("draft_number")
  // Draft | PartiallyPosted | Posted | Discarded
  status         String             @default("Draft")
  title          String
  entryDate      DateTime           @map("entry_date")
  cashAccountId  String             @map("cash_account_id")
  openingBalance Decimal?           @map("opening_balance") @db.Decimal(20, 2)
  closingBalance Decimal?           @map("closing_balance") @db.Decimal(20, 2)
  // manual | aira
  source         String             @default("manual")
  // Referensi opak chat/sesi engine AIRA (tidak diinterpretasi).
  sourceRef      String?            @map("source_ref")
  sourceNote     String?            @map("source_note")
  createdById    String             @map("created_by_id")
  // mcp | ui
  createdVia     String?            @map("created_via")
  postedAt       DateTime?          @map("posted_at")
  postedById     String?            @map("posted_by_id")
  lastError      String?            @map("last_error")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
