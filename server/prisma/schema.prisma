model GaWorkOrderPhoto {
  id          String               @id @default(cuid())
  workOrderId String               @map("work_order_id")
  filePath    String               @map("file_path")
  type        GaWorkOrderPhotoType
  caption     String?
  createdAt   DateTime             @default(now()) @map("created_at")
  workOrder   GaWorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("ga_work_order_photos")
}

model GaWorkOrderPart {
  id                  String               @id @default(cuid())
  workOrderId         String               @map("work_order_id")
  inventoryItemId     String               @map("inventory_item_id")
  fromLocationId      String?              @map("from_location_id")
  quantity            Decimal              @db.Decimal(12, 2)
  unitCost            Decimal              @map("unit_cost") @db.Decimal(14, 2)
  inventoryMovementId String?              @unique @map("inventory_movement_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  workOrder           GaWorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem       GaInventoryItem      @relation(fields: [inventoryItemId], references: [id])
  fromLocation        GaLocation?          @relation(fields: [fromLocationId], references: [id])
  movement            GaInventoryMovement? @relation(fields: [inventoryMovementId], references: [id])

  @@index([workOrderId])
  @@index([inventoryItemId])
  @@map("ga_work_order_parts")
}

model GaMaterialRequest {
  id              String                  @id @default(cuid())
  code            String                  @unique
  status          GaMaterialRequestStatus @default(DRAFT)
  workOrderId     String?                 @map("work_order_id")
  assetId         String?                 @map("asset_id")
  machineTarget   String?                 @map("machine_target")
  notes           String?
  requestedById   String                  @map("requested_by_id")
  requestedAt     DateTime                @default(now()) @map("requested_at")
  approvedById    String?                 @map("approved_by_id")
  approvedAt      DateTime?               @map("approved_at")
  rejectedById    String?                 @map("rejected_by_id")
  rejectedAt      DateTime?               @map("rejected_at")
  rejectReason    String?                 @map("reject_reason")
  // Forward-compat OPSI B (nullable, tidak dipakai sekarang): link ke PO/GL resmi.
  purchaseOrderId String?                 @map("purchase_order_id")
  glAccountId     String?                 @map("gl_account_id")
  // Linkage keuangan (diisi Akuntan saat bayar di ERP).
  journalEntryId    String?               @unique @map("journal_entry_id")
  purchaseInvoiceId String?               @map("purchase_invoice_id")
  creditAccountId   String?               @map("credit_account_id")
  paidById          String?               @map("paid_by_id")
  paidAt            DateTime?             @map("paid_at")
  paidAmount        Decimal?              @map("paid_amount") @db.Decimal(14, 2)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  workOrder       GaWorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  asset           GaAsset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  items           GaMaterialRequestItem[]
  journalEntry    JournalEntry?           @relation("GaMaterialRequestJournal", fields: [journalEntryId], references: [id])
  purchaseInvoice PurchaseInvoice?        @relation("GaMaterialRequestInvoice", fields: [purchaseInvoiceId], references: [id])
  glAccount       Account?                @relation("GaMaterialRequestExpense", fields: [glAccountId], references: [id])
  creditAccount   Account?                @relation("GaMaterialRequestCredit", fields: [creditAccountId], references: [id])

  @@index([status])
  @@index([workOrderId])
  @@index([assetId])
  @@map("ga_material_requests")
}

model GaMaterialRequestItem {
  id                     String              @id @default(cuid())
  materialRequestId      String              @map("material_request_id")
  inventoryItemId        String?             @map("inventory_item_id")
  itemName               String              @map("item_name")
  sku                    String?
  uom                    String
  quantity               Decimal             @db.Decimal(12, 2)
  notes                  String?
  // Procurement (diisi bertahap saat pengadaan sparepart).
  vendorName             String?             @map("vendor_name")
  unitPrice              Decimal             @default(0) @map("unit_price") @db.Decimal(14, 2)
  poNumber               String?             @map("po_number")
  procurementStatus      GaProcurementStatus @default(REQUESTED) @map("procurement_status")
  receivedQty            Decimal             @default(0) @map("received_qty") @db.Decimal(12, 2)
  receivedAt             DateTime?           @map("received_at")
  receivedIntoLocationId String?             @map("received_into_location_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  materialRequest        GaMaterialRequest   @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  inventoryItem          GaInventoryItem?    @relation(fields: [inventoryItemId], references: [id])
  receivedIntoLocation   GaLocation?         @relation(fields: [receivedIntoLocationId], references: [id])

  @@index([materialRequestId])
  @@index([inventoryItemId])
  @@map("ga_material_request_items")
}

model GaVehicleData {
  id               String             @id @default(cuid())
  assetId          String             @unique @map("asset_id")
