}

model CashBookDraftRow {
  id             String        @id @default(uuid())
  draftId        String        @map("draft_id")
  draft          CashBookDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  idx            Int
  rowDate        DateTime      @map("row_date")
  description    String
  amount         Decimal       @db.Decimal(20, 2)
  // masuk (kas masuk / debit kas) | keluar (kas keluar / kredit kas)
  direction      String
  // pengeluaran | pemasukan | uang_muka | terima_kasbon | lainnya
  txnType        String        @map("txn_type")
  accountId      String?       @map("account_id")
  accountCode    String?       @map("account_code")
  accountLabel   String?       @map("account_label")
  confidence     Decimal       @default(0) @db.Decimal(4, 3)
  needsReview    Boolean       @default(false) @map("needs_review")
  reason         String?
  skip           Boolean       @default(false)
  // true bila manusia memilih/menegaskan akun & jenis (dasar pembelajaran pola saat posting)
  userEdited     Boolean       @default(false) @map("user_edited")
