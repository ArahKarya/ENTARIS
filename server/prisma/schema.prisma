enum DocumentStatus {
  Draft
  Submitted
  Cancelled
}

enum InvoiceStatus {
  Draft
  Submitted
  Paid
  PartiallyPaid
  Overdue
  Cancelled
}

enum PaymentType {
  Receive
  Pay
  VendorDeposit
  CustomerDeposit
  VendorRefund
  CustomerRefund
}

