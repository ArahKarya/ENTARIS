generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum RootType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id                      String                   @id @default(uuid())
  name                    String
  accountNumber           String                   @unique
  accountType             AccountType
  rootType                RootType
  isGroup                 Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  balance                 Decimal                  @default(0) @db.Decimal(15, 2)
  currency                String                   @default("IDR")
  description             String?
  parentId                String?
  parent                  Account?                 @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                Account[]                @relation("AccountHierarchy")
  ledgerEntries           AccountingLedgerEntry[]
  journalItems            JournalItem[]
  salesItems              SalesInvoiceItem[]
  purchaseItems           PurchaseInvoiceItem[]
  quotationItems          QuotationItem[]          @relation("QuotationItemAccount")
  payments                Payment[]                @relation("PaymentAccount")
  paymentSplits           PaymentSplit[]           @relation("PaymentSplitAccount")
  inventoryItems          InventoryItem[]          @relation("ItemAccount")
  movementsAsOffset       StockMovement[]          @relation("MovementOffset")
  reconciliations         BankReconciliation[]     @relation("ReconciliationAccount")
  serviceItems            ServiceItem[]            @relation("ServiceItemAccount")
  systemAccountMappings   SystemAccountMapping[]   @relation("MappedAccount")
  fixedAssetsAsAsset      FixedAsset[]             @relation("AssetAccount")
  fixedAssetsAsDepr       FixedAsset[]             @relation("DepreciationAccount")
  fixedAssetsAsAccDep     FixedAsset[]             @relation("AccumulatedDepAccount")
  productionCostStandards ProductionCostStandard[] @relation("CostStandardAccount")
  productionRunCosts      ProductionRunCost[]      @relation("RunCostAccount")
  gaVehicleServiceExpense GaVehicleServiceLog[]    @relation("GaVehicleServiceExpense")
  gaVehicleTaxExpense     GaVehicleTax[]           @relation("GaVehicleTaxExpense")
  gaVehicleTaxCredit      GaVehicleTax[]           @relation("GaVehicleTaxCredit")
  gaMaterialRequestExpense GaMaterialRequest[]     @relation("GaMaterialRequestExpense")
  gaMaterialRequestCredit  GaMaterialRequest[]     @relation("GaMaterialRequestCredit")
  gaVehicleServiceCredit  GaVehicleServiceLog[]    @relation("GaVehicleServiceCredit")
  paymentRequestTypes     PaymentRequestType[]     @relation("PaymentRequestTypeAccount")
  paymentRequestLines     PaymentRequestLine[]     @relation("PaymentRequestLineAccount")
  paymentRequestsPaidFrom PaymentRequest[]         @relation("PaymentRequestCashAccount")
  paymentRequestsSettledFrom PaymentRequest[]      @relation("PaymentRequestSettlementCash")
  paymentRequestSettlementLines PaymentRequestSettlementLine[] @relation("PaymentRequestSettlementLineAccount")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([rootType])
  @@index([accountNumber])
  @@index([parentId])
  @@map("accounts")
}

model Party {
  id                     String                  @id @default(uuid())
  name                   String
  partyType              PartyType
  phone                  String?
  email                  String?
  address                String?
  taxId                  String?                 @map("tax_id")
  outstandingAmount      Decimal                 @default(0) @map("outstanding_amount") @db.Decimal(15, 2)
  openingOutstanding     Decimal                 @default(0) @map("opening_outstanding") @db.Decimal(15, 2)
  depositBalance         Decimal                 @default(0) @map("deposit_balance") @db.Decimal(15, 2)
  customerDepositBalance Decimal                 @default(0) @map("customer_deposit_balance") @db.Decimal(15, 2)
  isActive               Boolean                 @default(true) @map("is_active")
  isDummy                Boolean                 @default(false) @map("is_dummy")
  // WAPU (Wajib Pungut) — pemerintah/BUMN tertentu
  // memungut PPN sendiri ke kas negara. Tagihan ke mereka TIDAK include
  // PPN — frontend default tax_pct=0 untuk customer berlabel ini.
  isWapu                 Boolean                 @default(false) @map("is_wapu")
  salesInvoices          SalesInvoice[]
  purchaseInvoices       PurchaseInvoice[]
  payments               Payment[]
  quotations             Quotation[]             @relation("QuotationCustomer")
  inquiries              Inquiry[]               @relation("InquiryParty")
  deliveryOrders         DeliveryOrder[]         @relation("DeliveryOrderCustomer")
  salesOrders            SalesOrder[]            @relation("SalesOrderCustomer")
  purchaseOrders         PurchaseOrder[]         @relation("PurchaseOrderSupplier")
  goodsReceipts          GoodsReceipt[]          @relation("GoodsReceiptSupplier")
  salesReturns           SalesReturn[]
  projectGuarantees      ProjectGuarantee[]      @relation("ProjectGuaranteeParty")
  ledgerEntries          AccountingLedgerEntry[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([partyType])
  @@map("parties")
  paymentRequests        PaymentRequest[]        @relation("PaymentRequestParty")
}

enum PartyType {
  Customer
  Supplier
  Both
}

model AccountingLedgerEntry {
  id            String     @id @default(uuid())
  date          DateTime
  accountId     String     @map("account_id")
  account       Account    @relation(fields: [accountId], references: [id])
  partyId       String?    @map("party_id")
  party         Party?     @relation(fields: [partyId], references: [id])
  debit         Decimal    @default(0) @db.Decimal(15, 2)
  credit        Decimal    @default(0) @db.Decimal(15, 2)
  referenceType String     @map("reference_type")
  referenceId   String     @map("reference_id")
  description   String?
  fiscalYearId  String     @map("fiscal_year_id")
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id])
  isCancelled   Boolean    @default(false) @map("is_cancelled")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([accountId])
  @@index([date])
  @@index([fiscalYearId])
  @@index([referenceId])
  @@index([partyId])
  @@map("accounting_ledger_entries")
}

model JournalEntry {
  id                         String                      @id @default(uuid())
  entryNumber                String                      @unique @map("entry_number")
  date                       DateTime
  status                     DocumentStatus              @default(Draft)
  narration                  String?
  fiscalYearId               String                      @map("fiscal_year_id")
  fiscalYear                 FiscalYear                  @relation(fields: [fiscalYearId], references: [id])
  createdBy                  String                      @map("created_by")
  user                       User                        @relation(fields: [createdBy], references: [id])
  items                      JournalItem[]
  stockMovement              StockMovement?
  payment                    Payment?
  depositApplication         VendorDepositApplication?
  customerDepositApplication CustomerDepositApplication?
  depreciationEntries        DepreciationEntry[]
  cogsBackfillSettlements    CogsBackfillSettlement[]    @relation("CogsBackfillJE")
  gaVehicleServiceLog        GaVehicleServiceLog?        @relation("GaVehicleServiceJournal")
  gaVehicleTax               GaVehicleTax?               @relation("GaVehicleTaxJournal")
  gaMaterialRequest          GaMaterialRequest?          @relation("GaMaterialRequestJournal")
  paymentRequest             PaymentRequest?             @relation("PaymentRequestJournal")
  paymentRequestSettlement   PaymentRequest?             @relation("PaymentRequestSettlementJournal")
  submittedAt                DateTime?                   @map("submitted_at")
  isDummy                    Boolean                     @default(false) @map("is_dummy")
  cancelledAt                DateTime?                   @map("cancelled_at")
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@index([status])
  @@index([date])
  @@index([fiscalYearId])
  @@map("journal_entries")
}

model JournalItem {
  id             String       @id @default(uuid())
  journalEntryId String       @map("journal_entry_id")
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])
  partyId        String?      @map("party_id")
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_accounts")
}

model SalesInvoice {
  id                  String                       @id @default(uuid())
  invoiceNumber       String                       @unique @map("invoice_number")
  date                DateTime
  partyId             String                       @map("party_id")
  customer            Party                        @relation(fields: [partyId], references: [id])
  status              InvoiceStatus                @default(Draft)
  grandTotal          Decimal                      @map("grand_total") @db.Decimal(15, 2)
  outstanding         Decimal                      @db.Decimal(15, 2)
  taxPct              Decimal                      @default(0) @map("tax_pct") @db.Decimal(5, 2)
  potongan            Decimal                      @default(0) @db.Decimal(15, 2)
  biayaLain           Decimal                      @default(0) @map("biaya_lain") @db.Decimal(15, 2)
  labelPotongan       String?                      @map("label_potongan")
  labelBiaya          String?                      @map("label_biaya")
  terms               String?
  dueDate             DateTime?                    @map("due_date")
  notes               String?
  customerRefNo       String?                      @map("customer_ref_no")
  fiscalYearId        String                       @map("fiscal_year_id")
  fiscalYear          FiscalYear                   @relation(fields: [fiscalYearId], references: [id])
  createdBy           String                       @map("created_by")
  user                User                         @relation(fields: [createdBy], references: [id])
  items               SalesInvoiceItem[]
  cogsBackfills       CogsBackfillQueue[]
  depositApplications CustomerDepositApplication[] @relation("CustomerDepositApplied")
  quotation           Quotation?                   @relation("QuotationConvertedTo")
  deliveryOrders      DeliveryOrder[]              @relation("DeliveryOrderInvoice")
  returns             SalesReturn[]
  submittedAt         DateTime?                    @map("submitted_at")
  cancelledAt         DateTime?                    @map("cancelled_at")
  isDummy             Boolean                      @default(false) @map("is_dummy")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([fiscalYearId])
  @@map("sales_invoices")
}

enum QuotationStatus {
  Draft
  Sent
  Accepted
  Rejected
  Expired
  Cancelled
}

enum SalesOrderStatus {
  Draft
  Submitted
  PartiallyDelivered
  FullyDelivered
  Cancelled
}

model SalesOrder {
  id               String           @id @default(uuid())
  soNumber         String           @unique @map("so_number")
  date             DateTime
  expectedDelivery DateTime?        @map("expected_delivery")
  partyId          String           @map("party_id")
  customer         Party            @relation("SalesOrderCustomer", fields: [partyId], references: [id])
  customerRefNo    String?          @map("customer_ref_no")
  // Optional link kalau SO digenerate dari Quotation yang Accepted.
  quotationId      String?          @map("quotation_id")
  quotation        Quotation?       @relation("SalesOrderFromQuotation", fields: [quotationId], references: [id])
  status           SalesOrderStatus @default(Draft)
  notes            String?
  subtotal         Decimal          @db.Decimal(15, 2)
  taxPct           Decimal          @default(0) @map("tax_pct") @db.Decimal(5, 2)
  potongan         Decimal          @default(0) @db.Decimal(15, 2)
  biayaLain        Decimal          @default(0) @map("biaya_lain") @db.Decimal(15, 2)
  grandTotal       Decimal          @map("grand_total") @db.Decimal(15, 2)
  fiscalYearId     String           @map("fiscal_year_id")
  fiscalYear       FiscalYear       @relation("SalesOrderFiscalYear", fields: [fiscalYearId], references: [id])
  createdBy        String           @map("created_by")
  user             User             @relation("SalesOrderCreator", fields: [createdBy], references: [id])
  items            SalesOrderItem[]
  deliveryOrders   DeliveryOrder[]  @relation("DOFromSO")
  depositPayments  Payment[]        @relation("SalesOrderDeposits")
  submittedAt      DateTime?        @map("submitted_at")
  cancelledAt      DateTime?        @map("cancelled_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([quotationId])
  @@index([fiscalYearId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                 String              @id @default(uuid())
  salesOrderId       String              @map("sales_order_id")
  salesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryItemId    String?             @map("inventory_item_id")
  inventoryItem      InventoryItem?      @relation("SOItemInventory", fields: [inventoryItemId], references: [id])
  itemName           String              @map("item_name")
  quantity           Decimal             @db.Decimal(15, 3)
  unit               String
  rate               Decimal             @db.Decimal(15, 2)
  discount           Decimal             @default(0) @db.Decimal(5, 2)
  amount             Decimal             @db.Decimal(15, 2)
  description        String?
  // Akumulasi qty yang sudah dikirim via DO (multiple DO bisa link ke 1 SO item).
  deliveredQty       Decimal             @default(0) @map("delivered_qty") @db.Decimal(15, 3)
  deliveryOrderItems DeliveryOrderItem[] @relation("DOLineFromSO")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([salesOrderId])
  @@index([inventoryItemId])
  @@map("sales_order_items")
}

model Quotation {
  id               String          @id @default(uuid())
  quotationNumber  String          @unique @map("quotation_number")
  date             DateTime
  validUntil       DateTime        @map("valid_until")
  partyId          String          @map("party_id")
  customer         Party           @relation("QuotationCustomer", fields: [partyId], references: [id])
  status           QuotationStatus @default(Draft)
  subtotal         Decimal         @db.Decimal(15, 2)
  taxPct           Decimal         @default(0) @map("tax_pct") @db.Decimal(5, 2)
  potongan         Decimal         @default(0) @db.Decimal(15, 2)
  biayaLain        Decimal         @default(0) @map("biaya_lain") @db.Decimal(15, 2)
  labelPotongan    String?         @map("label_potongan")
  labelBiaya       String?         @map("label_biaya")
  grandTotal       Decimal         @map("grand_total") @db.Decimal(15, 2)
  terms            String?
  notes            String?
  rejectReason     String?         @map("reject_reason")
  salesInvoiceId   String?         @unique @map("sales_invoice_id")
  salesInvoice     SalesInvoice?   @relation("QuotationConvertedTo", fields: [salesInvoiceId], references: [id])
  salesOrders      SalesOrder[]    @relation("SalesOrderFromQuotation")
  inquiry          Inquiry?        @relation("QuotationFromInquiry")
  fiscalYearId     String          @map("fiscal_year_id")
  fiscalYear       FiscalYear      @relation("QuotationFiscalYear", fields: [fiscalYearId], references: [id])
  createdBy        String          @map("created_by")
  user             User            @relation("QuotationCreator", fields: [createdBy], references: [id])
  items            QuotationItem[]
  sentAt           DateTime?       @map("sent_at")
  acceptedAt       DateTime?       @map("accepted_at")
  rejectedAt       DateTime?       @map("rejected_at")
  expiredAt        DateTime?       @map("expired_at")
  convertedAt      DateTime?       @map("converted_at")
  cancelledAt      DateTime?       @map("cancelled_at")
  expiryNotifiedAt DateTime?       @map("expiry_notified_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([validUntil])
  @@index([fiscalYearId])
  @@index([status, validUntil])
  @@map("quotations")
}

model QuotationItem {
  id              String         @id @default(uuid())
  quotationId     String         @map("quotation_id")
  quotation       Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemType        String         @default("product") @map("item_type")
  inventoryItemId String?        @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation("QuotationItemInventory", fields: [inventoryItemId], references: [id])
  serviceItemId   String?        @map("service_item_id")
  serviceItem     ServiceItem?   @relation("QuotationItemService", fields: [serviceItemId], references: [id])
  accountId       String?        @map("account_id")
  account         Account?       @relation("QuotationItemAccount", fields: [accountId], references: [id])
  itemName        String         @map("item_name")
  quantity        Decimal        @db.Decimal(15, 3)
  unit            String         @default("Kg")
  rate            Decimal        @db.Decimal(15, 2)
  discount        Decimal        @default(0) @db.Decimal(5, 2)
  amount          Decimal        @db.Decimal(15, 2)
  taxPct          Decimal        @default(0) @map("tax_pct") @db.Decimal(5, 2)
  pphPct          Decimal        @default(0) @map("pph_pct") @db.Decimal(5, 2)
  description     String?
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([quotationId])
  @@index([inventoryItemId])
  @@index([serviceItemId])
  @@map("quotation_items")
}

enum InquiryStatus {
  Baru
  Diproses
  Dikonversi
  Hilang
  Ditutup
}

enum InquiryChannel {
  WhatsApp
  Telepon
  Email
  WalkIn
  Referral
  Lainnya
}

// Customer/prospect inquiry — captured before a Quotation is issued.
// Lives in the Sales pipeline as the earliest stage: Inquiry → Quotation → Sales Invoice.
model Inquiry {
  id            String         @id @default(uuid())
  inquiryNumber String         @unique @map("inquiry_number")
  date          DateTime
  status        InquiryStatus  @default(Baru)
  channel       InquiryChannel @default(Lainnya)

  // Contact info — partyId optional (prospect not yet in Parties).
  // prospectName always present (denormalized for fast list display).
  partyId       String? @map("party_id")
  party         Party?  @relation("InquiryParty", fields: [partyId], references: [id])
  prospectName  String  @map("prospect_name")
  prospectPhone String? @map("prospect_phone")
  prospectEmail String? @map("prospect_email")

  // Items: hybrid — either a freetext blob OR structured InquiryItem rows.
  itemsMode String        @default("freetext") @map("items_mode") // 'freetext' | 'structured'
  itemsText String?       @map("items_text")
  items     InquiryItem[]

  notes        String?
  followUpDate DateTime? @map("follow_up_date")
  lossReason   String?   @map("loss_reason")

  // Conversion link — set once when convert-to-quotation succeeds.
  quotationId String?    @unique @map("quotation_id")
  quotation   Quotation? @relation("QuotationFromInquiry", fields: [quotationId], references: [id])
  convertedAt DateTime?  @map("converted_at")

  fiscalYearId String     @map("fiscal_year_id")
  fiscalYear   FiscalYear @relation("InquiryFiscalYear", fields: [fiscalYearId], references: [id])
  createdBy    String     @map("created_by")
  user         User       @relation("InquiryCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([fiscalYearId])
  @@map("inquiries")
}

model InquiryItem {
  id             String   @id @default(uuid())
  inquiryId      String   @map("inquiry_id")
  inquiry        Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  itemName       String   @map("item_name")
  quantity       Decimal? @db.Decimal(15, 3)
  unit           String?
  estimatedPrice Decimal? @map("estimated_price") @db.Decimal(15, 2)
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([inquiryId])
  @@map("inquiry_items")
}

model SalesInvoiceItem {
  id                  String              @id @default(uuid())
  salesInvoiceId      String              @map("sales_invoice_id")
  salesInvoice        SalesInvoice        @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemType            String              @default("product") @map("item_type")
  inventoryItemId     String?             @map("inventory_item_id")
  inventoryItem       InventoryItem?      @relation("SalesInvoiceInventory", fields: [inventoryItemId], references: [id])
  warehouseId         String?             @map("warehouse_id")
  warehouse           Warehouse?          @relation("SalesInvoiceItemWarehouse", fields: [warehouseId], references: [id])
  serviceItemId       String?             @map("service_item_id")
  serviceItem         ServiceItem?        @relation("SalesInvoiceService", fields: [serviceItemId], references: [id])
  // From-DO lines: this invoice line was generated by aggregating an existing
  // delivery order item. Skip stock-out at invoice submit (DO already did);
  // COGS uses the locked unitCost from the DO's stockMovement.
  deliveryOrderItemId String?             @unique @map("delivery_order_item_id")
  deliveryOrderItem   DeliveryOrderItem?  @relation(fields: [deliveryOrderItemId], references: [id])
  cogsBackfills       CogsBackfillQueue[]
  returnItems         SalesReturnItem[]
  itemName            String              @map("item_name")
  quantity            Decimal             @db.Decimal(15, 3)
  unit                String
  rate                Decimal             @db.Decimal(15, 2)
  discount            Decimal             @default(0) @db.Decimal(5, 2)
  amount              Decimal             @db.Decimal(15, 2)
  taxPct              Decimal             @default(0) @map("tax_pct") @db.Decimal(5, 2)
  pphPct              Decimal             @default(0) @map("pph_pct") @db.Decimal(5, 2)
  accountId           String              @map("account_id")
  account             Account             @relation(fields: [accountId], references: [id])
  description         String?
  // Batch picker: the stock-out created at submit links to this inbound batch.
  // unitCostLoaded is the loaded HPP captured at submit (loaded-margin reports).
  sourceMovementId    String?             @map("source_movement_id")
  sourceMovement      StockMovement?      @relation("SalesBatchSource", fields: [sourceMovementId], references: [id])
  unitCostLoaded      Decimal?            @map("unit_cost_loaded") @db.Decimal(20, 4)

  @@index([salesInvoiceId])
  @@index([sourceMovementId])
  @@index([inventoryItemId])
  @@index([serviceItemId])
  @@index([warehouseId])
  @@map("sales_invoice_items")
}

// Delivery Order (Surat Jalan): decrements stock without GL; several DOs can be billed on one
// invoice. Its stock movements lock unitCost at delivery so invoice COGS matches what left.
model DeliveryOrder {
  id            String              @id @default(uuid())
  doNumber      String              @unique @map("do_number")
  date          DateTime
  partyId       String              @map("party_id")
  customer      Party               @relation("DeliveryOrderCustomer", fields: [partyId], references: [id])
  status        DocumentStatus      @default(Submitted)
  notes         String?
  // Pengiriman fisik
  nomorMobil    String?             @map("nomor_mobil")
  driverName    String?             @map("driver_name")
  recipientName String?             @map("recipient_name")
  // Billing linkage — set once items are folded into an invoice.
  invoiceId     String?             @map("invoice_id")
  invoice       SalesInvoice?       @relation("DeliveryOrderInvoice", fields: [invoiceId], references: [id])
  invoicedAt    DateTime?           @map("invoiced_at")
  // Sales order linkage (optional): kalau DO digenerate dari SO.
  salesOrderId  String?             @map("sales_order_id")
  salesOrder    SalesOrder?         @relation("DOFromSO", fields: [salesOrderId], references: [id])
  fiscalYearId  String              @map("fiscal_year_id")
  fiscalYear    FiscalYear          @relation("DeliveryOrderFiscalYear", fields: [fiscalYearId], references: [id])
  createdBy     String              @map("created_by")
  user          User                @relation("DeliveryOrderCreator", fields: [createdBy], references: [id])
  items         DeliveryOrderItem[]
  submittedAt   DateTime?           @map("submitted_at")
  cancelledAt   DateTime?           @map("cancelled_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([date])
  @@index([partyId])
  @@index([status])
  @@index([invoiceId])
  @@index([salesOrderId])
  @@index([fiscalYearId])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id               String            @id @default(uuid())
  deliveryOrderId  String            @map("delivery_order_id")
  deliveryOrder    DeliveryOrder     @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  inventoryItemId  String?           @map("inventory_item_id")
  inventoryItem    InventoryItem?    @relation("DOLineInventory", fields: [inventoryItemId], references: [id])
  warehouseId      String?           @map("warehouse_id")
  warehouse        Warehouse?        @relation("DOLineWarehouse", fields: [warehouseId], references: [id])
  itemName         String            @map("item_name")
  quantity         Decimal           @db.Decimal(15, 3)
  unit             String
  description      String?
  // Link to the stockMovement Out row created when this DO was submitted.
  // unitCost is locked there so COGS at invoice time matches the goods'
  // actual cost at delivery.
  stockMovementId  String?           @unique @map("stock_movement_id")
  stockMovement    StockMovement?    @relation("DOLineMovement", fields: [stockMovementId], references: [id])
  // Link back to source SO line (for partial-delivery tracking).
  salesOrderItemId String?           @map("sales_order_item_id")
  salesOrderItem   SalesOrderItem?   @relation("DOLineFromSO", fields: [salesOrderItemId], references: [id])
  // Back-relation: which sales invoice line picked this DO item up.
  invoiceItem      SalesInvoiceItem?
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([deliveryOrderId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([salesOrderItemId])
  @@map("delivery_order_items")
}

model PurchaseInvoice {
  id                  String                     @id @default(uuid())
  invoiceNumber       String                     @unique @map("invoice_number")
  date                DateTime
  partyId             String                     @map("party_id")
  supplier            Party                      @relation(fields: [partyId], references: [id])
  status              InvoiceStatus              @default(Draft)
  grandTotal          Decimal                    @map("grand_total") @db.Decimal(15, 2)
  outstanding         Decimal                    @db.Decimal(15, 2)
  taxPct              Decimal                    @default(0) @map("tax_pct") @db.Decimal(5, 2)
  potongan            Decimal                    @default(0) @db.Decimal(15, 2)
  biayaLain           Decimal                    @default(0) @map("biaya_lain") @db.Decimal(15, 2)
  dueDate             DateTime?                  @map("due_date")
  notes               String?
  terms               String?
  fiscalYearId        String                     @map("fiscal_year_id")
  fiscalYear          FiscalYear                 @relation(fields: [fiscalYearId], references: [id])
  createdBy           String                     @map("created_by")
  user                User                       @relation(fields: [createdBy], references: [id])
  items               PurchaseInvoiceItem[]
  depositApplications VendorDepositApplication[] @relation("DepositApplied")
  // PO linkage (header shortcut). Lines may still come from STT via per-line link.
  purchaseOrderId     String?                    @map("purchase_order_id")
  purchaseOrder       PurchaseOrder?             @relation("PIFromPO", fields: [purchaseOrderId], references: [id])
  // STT (GoodsReceipt) header-level back-relation. PI created from STT.
  // 1 STT → at most 1 active PI; many lines billed at once.
  // One PI can bill several STTs at once (combined invoice).
  goodsReceipts       GoodsReceipt[]             @relation("PIFromGR")
  gaVehicleTaxes      GaVehicleTax[]             @relation("GaVehicleTaxInvoice")
  gaServiceLogs       GaVehicleServiceLog[]      @relation("GaServiceLogInvoice")
  gaMaterialRequests  GaMaterialRequest[]        @relation("GaMaterialRequestInvoice")
  // Marks PIs migrated to the new "stock-from-STT" flow as legacy/backfilled
  // (their JV still posts DR Persediaan / CR Hutang Usaha for historical truth).
  isLegacyStockFlow   Boolean                    @default(false) @map("is_legacy_stock_flow")
  submittedAt         DateTime?                  @map("submitted_at")
  cancelledAt         DateTime?                  @map("cancelled_at")
  isDummy             Boolean                    @default(false) @map("is_dummy")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([status])
  @@index([date])
  @@index([fiscalYearId])
  @@index([purchaseOrderId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                 String            @id @default(uuid())
  purchaseInvoiceId  String            @map("purchase_invoice_id")
  purchaseInvoice    PurchaseInvoice   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  // 'product' (goods) | 'service' (jasa/biaya). Column added by loose SQL 2026101800000.
  itemType           String            @default("product") @map("item_type")
  inventoryItemId    String?           @map("inventory_item_id")
  inventoryItem      InventoryItem?    @relation("PurchaseInvoiceInventory", fields: [inventoryItemId], references: [id])
  warehouseId        String?           @map("warehouse_id")
  warehouse          Warehouse?        @relation("PurchaseInvoiceItemWarehouse", fields: [warehouseId], references: [id])
  itemName           String            @map("item_name")
  quantity           Decimal           @db.Decimal(15, 3)
  unit               String
  rate               Decimal           @db.Decimal(15, 2)
  discount           Decimal           @default(0) @db.Decimal(5, 2)
  amount             Decimal           @db.Decimal(15, 2)
  taxPct             Decimal           @default(0) @map("tax_pct") @db.Decimal(5, 2)
  pphPct             Decimal           @default(0) @map("pph_pct") @db.Decimal(5, 2)
  potonganItem       Decimal           @default(0) @map("potongan_item") @db.Decimal(15, 2)
  kualitas           String?
  refaksi            Decimal?          @db.Decimal(15, 3)
  timbanganTruk      Decimal?          @map("timbangan_truk") @db.Decimal(15, 3)
  timbanganDiterima  Decimal?          @map("timbangan_diterima") @db.Decimal(15, 3)
  nomorMobil         String?           @map("nomor_mobil")
  accountId          String            @map("account_id")
  account            Account           @relation(fields: [accountId], references: [id])
  description        String?
  // Link ke baris STT yang menyebabkan stok masuk. UNIQUE — tiap baris STT
  // hanya bisa di-invoice sekali. Nullable untuk PI legacy / standalone (no
  // STT existed when invoice was first created).
  goodsReceiptItemId String?           @unique @map("goods_receipt_item_id")
  goodsReceiptItem   GoodsReceiptItem? @relation("PILineFromGRLine", fields: [goodsReceiptItemId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@map("purchase_invoice_items")
}

model Payment {
  id                          String                       @id @default(uuid())
  paymentNumber               String                       @unique @map("payment_number")
  date                        DateTime
  paymentType                 PaymentType                  @map("payment_type")
  partyId                     String                       @map("party_id")
  party                       Party                        @relation(fields: [partyId], references: [id])
  accountId                   String                       @map("account_id")
  account                     Account                      @relation("PaymentAccount", fields: [accountId], references: [id])
  amount                      Decimal                      @db.Decimal(15, 2)
  refundedAmount              Decimal                      @default(0) @map("refunded_amount") @db.Decimal(15, 2)
  status                      DocumentStatus               @default(Draft)
  referenceNo                 String?                      @map("reference_number")
  notes                       String?
  createdBy                   String                       @map("created_by")
  user                        User                         @relation(fields: [createdBy], references: [id])
  allocations                 PaymentAllocation[]
  splits                      PaymentSplit[]
  depositApplications         VendorDepositApplication[]   @relation("DepositApplications")
  customerDepositApplications CustomerDepositApplication[] @relation("CustomerDepositApplications")
  journalEntryId              String?                      @unique @map("journal_entry_id")
  journalEntry                JournalEntry?                @relation(fields: [journalEntryId], references: [id])
  // Optional: kalau pembayaran ini uang muka (CustomerDeposit) untuk SO tertentu.
  salesOrderId                String?                      @map("sales_order_id")
  salesOrder                  SalesOrder?                  @relation("SalesOrderDeposits", fields: [salesOrderId], references: [id])
  fiscalYearId                String                       @map("fiscal_year_id")
  fiscalYear                  FiscalYear                   @relation(fields: [fiscalYearId], references: [id])
  submittedAt                 DateTime?                    @map("submitted_at")
  cancelledAt                 DateTime?                    @map("cancelled_at")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  @@index([partyId])
  @@index([accountId])
  @@index([status])
  @@index([date])
  @@index([fiscalYearId])
  @@map("payments")
}

model PaymentSplit {
  id        String  @id @default(uuid())
  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  accountId String  @map("account_id")
  account   Account @relation("PaymentSplitAccount", fields: [accountId], references: [id])
  amount    Decimal @db.Decimal(15, 2)
  notes     String?

  @@index([paymentId])
  @@index([accountId])
  @@map("payment_splits")
}

model PaymentAllocation {
  id              String  @id @default(uuid())
  paymentId       String  @map("payment_id")
  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceType     String  @map("invoice_type")
  invoiceId       String  @map("invoice_id")
  allocatedAmount Decimal @map("allocated_amount") @db.Decimal(15, 2)

  @@index([paymentId])
  @@index([invoiceType, invoiceId])
  @@map("payment_allocations")
}

model FiscalYear {
  id               String                  @id @default(uuid())
  name             String                  @unique
  startDate        DateTime                @map("start_date")
  endDate          DateTime                @map("end_date")
  isClosed         Boolean                 @default(false) @map("is_closed")
  closedAt         DateTime?               @map("closed_at")
  closedBy         String?                 @map("closed_by")
  user             User?                   @relation("ClosedBy", fields: [closedBy], references: [id])
  ledgerEntries    AccountingLedgerEntry[]
  journalEntries   JournalEntry[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  quotations       Quotation[]             @relation("QuotationFiscalYear")
  inquiries        Inquiry[]               @relation("InquiryFiscalYear")
  payments         Payment[]
  stockMovements   StockMovement[]
  productionRuns   ProductionRun[]
  stockOpnames     StockOpname[]
  stockTransfers   StockTransfer[]         @relation("TransferFiscalYear")
  deliveryOrders   DeliveryOrder[]         @relation("DeliveryOrderFiscalYear")
  salesOrders      SalesOrder[]            @relation("SalesOrderFiscalYear")
  purchaseOrders   PurchaseOrder[]         @relation("PurchaseOrderFY")
  goodsReceipts    GoodsReceipt[]          @relation("GoodsReceiptFY")
  fixedAssets      FixedAsset[]
  cogsBackfills    CogsBackfillQueue[]     @relation("CogsBackfillFY")
  createdAt        DateTime                @default(now()) @map("created_at")

  @@map("fiscal_years")
}

model User {
  id                          String                       @id @default(uuid())
  username                    String                       @unique
  fullName                    String                       @map("full_name")
  email                       String                       @unique
  passwordHash                String                       @map("password_hash")
  // role = Role.key (string dinamis). Nilai lama 'Admin'/'Accountant'/'StaffProduksi'/'Viewer'
  // tetap valid; role custom dibuat Admin lewat RBAC. Enum UserRole sudah ditinggalkan.
  role                        String                       @default("Accountant")
  isActive                    Boolean                      @default(true) @map("is_active")
  lastLoginAt                 DateTime?                    @map("last_login_at")
  // Notifikasi Telegram japri: chat id pribadi (tertaut via /start) + kode tautan sementara.
  telegramChatId              String?                      @map("telegram_chat_id")
  telegramLinkCode            String?                      @unique @map("telegram_link_code")
  // AIRA (MCP): user harus didaftarkan agar bisa dipakai sebagai aktor agen. Channel
  // (WhatsApp/Telegram) TIDAK disimpan di Entaris — engine AIRA memetakan identitas channel ke user id.
  airaEnabled                 Boolean                      @default(false) @map("aira_enabled")
  // read = hanya tool baca | standard = semua tool dgn tier (tulis non-draft & kritis → antrian approval) | direct = tulis/kritis langsung sebagai aktor
  airaTier                    String                       @default("standard") @map("aira_tier")
  airaJabatan                 String?                      @map("aira_jabatan")
  journalEntries              JournalEntry[]
  salesInvoices               SalesInvoice[]
  purchaseInvoices            PurchaseInvoice[]
  quotations                  Quotation[]                  @relation("QuotationCreator")
  inquiries                   Inquiry[]                    @relation("InquiryCreator")
  payments                    Payment[]
  closedYears                 FiscalYear[]                 @relation("ClosedBy")
  audits                      AuditLog[]
  stockMovements              StockMovement[]              @relation("MovementCreatedBy")
  productionRuns              ProductionRun[]              @relation("ProductionCreatedBy")
  notifications               Notification[]               @relation("UserNotifications")
  recurringTemplates          RecurringTemplate[]          @relation("UserRecurring")
  vendorDepositApplications   VendorDepositApplication[]
  customerDepositApplications CustomerDepositApplication[]
  tokenBlacklist              TokenBlacklist[]
  attachments                 TransactionAttachment[]
  stockOpnames                StockOpname[]                @relation("OpnameCreatedBy")
  stockTransfers              StockTransfer[]              @relation("TransferCreator")
  deliveryOrders              DeliveryOrder[]              @relation("DeliveryOrderCreator")
  salesOrders                 SalesOrder[]                 @relation("SalesOrderCreator")
  purchaseOrders              PurchaseOrder[]              @relation("PurchaseOrderCreator")
  goodsReceipts               GoodsReceipt[]               @relation("GoodsReceiptCreator")
  fixedAssets                 FixedAsset[]                 @relation("AssetCreatedBy")
  approvalRequests            ApprovalRequest[]            @relation("ApprovalRequester")
  approvalApprovals           ApprovalRequest[]            @relation("ApprovalApprover")
  approvalRejections          ApprovalRequest[]            @relation("ApprovalRejecter")
  // Atasan langsung (approver tahap 1 Pengajuan Pembayaran). Nullable.
  supervisorId                String?                      @map("supervisor_id")
  supervisor                  User?                        @relation("UserSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates                User[]                       @relation("UserSupervisor")
  paymentRequests             PaymentRequest[]             @relation("PaymentRequestRequester")
  paymentRequestsSupervised   PaymentRequest[]             @relation("PaymentRequestSupervisor")
  paymentRequestSettlementsSupervised PaymentRequest[]     @relation("PaymentRequestSettlementSupervisor")
  paymentRequestsPaid         PaymentRequest[]             @relation("PaymentRequestPaidBy")
  paymentRequestHistory       PaymentRequestHistory[]      @relation("PaymentRequestHistoryActor")
  chatSessions                ChatSession[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")

  @@map("users")
}

// RBAC Dinamis: Role custom + matriks izin (role × modul → view/edit)
// Role.key dirujuk oleh User.role (string). Role bawaan isSystem=true (tak bisa
// dihapus); Admin isSuperAdmin=true (lolos semua cek). Lihat constants/modules.ts.
model Role {
  id           String           @id @default(uuid())
  key          String           @unique
  name         String
  description  String?
  isSystem     Boolean          @default(false) @map("is_system")
  isSuperAdmin Boolean          @default(false) @map("is_super_admin")
  isActive     Boolean          @default(true) @map("is_active")
  permissions  RolePermission[]
  capabilities RoleCapability[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model RolePermission {
  id      String  @id @default(uuid())
  roleId  String  @map("role_id")
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module  String
  canView Boolean @default(false) @map("can_view")
  canEdit Boolean @default(false) @map("can_edit")

  @@unique([roleId, module])
  @@map("role_permissions")
}

model RoleCapability {
  id         String @id @default(uuid())
  roleId     String @map("role_id")
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  capability String

  @@unique([roleId, capability])
  @@map("role_capabilities")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([expiresAt])
  @@map("token_blacklist")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  /// 'mcp' bila aksi dijalankan agen lewat MCP; viaMeta = { token, channel, tool, approvalId? }.
  via        String?
  viaMeta    Json?    @map("via_meta")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_trail")
}

model CompanySettings {
  id                   String  @id @default(uuid())
  slug                 String  @unique @default("default")
  companyName          String  @map("company_name")
  address              String?
  phone                String?
  email                String?
  taxId                String? @map("tax_id")
  logoUrl              String? @map("logo_url")
  logoUrlDark          String? @map("logo_url_dark")
  defaultCurrency      String  @default("IDR") @map("default_currency")
  fiscalYearStartMonth Int     @default(1) @map("fiscal_year_start_month")
  invoiceSettings      Json?   @map("invoice_settings")
  /// Penyiapan awal (onboarding wizard) selesai/dilewati admin. NULL = belum.
  onboardedAt          DateTime? @map("onboarded_at")

  @@map("company_settings")
}

model SystemAccountMapping {
  id        String   @id @default(uuid())
  role      String
  accountId String   @map("account_id")
  account   Account  @relation("MappedAccount", fields: [accountId], references: [id])
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([role, accountId])
  @@index([role])
  @@map("system_account_mappings")
}

enum DocumentStatus {
  Draft
  Submitted
  Cancelled
}

enum InvoiceStatus {
  Draft
  Submitted
  Paid
  PartiallyPaid
  Overdue
  Cancelled
}

enum PaymentType {
  Receive
  Pay
  VendorDeposit
  CustomerDeposit
  VendorRefund
  CustomerRefund
}

enum UserRole {
  Admin
  Accountant
  StaffProduksi
  Viewer
}

enum StockMovementType {
  In
  Out
  AdjustmentIn
  AdjustmentOut
  TransferOut
  TransferIn
}

// Storage location. Stock is tracked per (item, warehouse) in InventoryStock; averageCost
// stays at item level by design (one weighted average across warehouses).
model Warehouse {
  id                   String                   @id @default(uuid())
  code                 String                   @unique
  name                 String
  location             String?
  description          String?
  isActive             Boolean                  @default(true) @map("is_active")
  isDefault            Boolean                  @default(false) @map("is_default")
  sortOrder            Int                      @default(0) @map("sort_order")
  stocks               InventoryStock[]
  movements            StockMovement[]
  transfersFrom        StockTransfer[]          @relation("TransferFrom")
  transfersTo          StockTransfer[]          @relation("TransferTo")
  purchaseInvoiceItems PurchaseInvoiceItem[]    @relation("PurchaseInvoiceItemWarehouse")
  salesInvoiceItems    SalesInvoiceItem[]       @relation("SalesInvoiceItemWarehouse")
  productionLines      ProductionRunItem[]      @relation("ProductionLineWarehouse")
  opnameLines          StockOpnameItem[]        @relation("OpnameLineWarehouse")
  opnames              StockOpname[]            @relation("OpnameWarehouse")
  deliveryOrderItems   DeliveryOrderItem[]      @relation("DOLineWarehouse")
  goodsReceiptItems    GoodsReceiptItem[]       @relation("GRItemWarehouse")
  costStandards        ProductionCostStandard[] @relation("WarehouseCostStandards")
  purchaseOrders       PurchaseOrder[]          @relation("PurchaseOrderWarehouse")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("warehouses")
}

// Stock balance per (item, warehouse). Replaces single-tenant
// InventoryItem.currentStock as the source of truth for "where is the
// stock physically?". InventoryItem.currentStock stays as a denormalized
// total (sum across all warehouses) for fast list-page queries.
model InventoryStock {
  id           String        @id @default(uuid())
  itemId       String        @map("item_id")
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId  String        @map("warehouse_id")
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  currentStock Decimal       @default(0) @map("current_stock") @db.Decimal(20, 3)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@map("inventory_stocks")
}

model InventoryItem {
  id                   String                   @id @default(uuid())
  code                 String                   @unique
  name                 String
  unit                 String
  category             String?
  description          String?
  currentStock         Decimal                  @default(0) @map("current_stock") @db.Decimal(15, 3)
  averageCost          Decimal                  @default(0) @map("average_cost") @db.Decimal(20, 2)
  minimumStock         Decimal                  @default(0) @map("minimum_stock") @db.Decimal(15, 3)
  isActive             Boolean                  @default(true) @map("is_active")
  isDummy              Boolean                  @default(false) @map("is_dummy")
  accountId            String?                  @map("account_id")
  account              Account?                 @relation("ItemAccount", fields: [accountId], references: [id])
  stocks               InventoryStock[]
  movements            StockMovement[]
  productionLines      ProductionRunItem[]      @relation("ProductionLines")
  salesInvoiceItems    SalesInvoiceItem[]       @relation("SalesInvoiceInventory")
  purchaseInvoiceItems PurchaseInvoiceItem[]    @relation("PurchaseInvoiceInventory")
  quotationItems       QuotationItem[]          @relation("QuotationItemInventory")
  opnameLines          StockOpnameItem[]        @relation("OpnameLines")
  cogsBackfills        CogsBackfillQueue[]      @relation("CogsBackfillItem")
  transferLines        StockTransferItem[]
  deliveryOrderItems   DeliveryOrderItem[]      @relation("DOLineInventory")
  salesOrderItems      SalesOrderItem[]         @relation("SOItemInventory")
  purchaseOrderItems   PurchaseOrderItem[]      @relation("POItemInventory")
  goodsReceiptItems    GoodsReceiptItem[]       @relation("GRItemInventory")
  costStandards        ProductionCostStandard[] @relation("ItemCostStandards")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([accountId])
  @@map("inventory_items")
}

// Stock transfer between warehouses. One logical transfer → two
// StockMovement rows (TransferOut from source + TransferIn to destination)
// plus an InventoryStock decrement/increment pair. No GL impact (same
// account on both sides).
model StockTransfer {
  id              String              @id @default(uuid())
  transferNumber  String              @unique @map("transfer_number")
  date            DateTime
  fromWarehouseId String              @map("from_warehouse_id")
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String              @map("to_warehouse_id")
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          DocumentStatus      @default(Draft)
  notes           String?
  items           StockTransferItem[]
  // SJG (Surat Jalan Antar Gudang) metadata for the driver's PDF only; stock
  // still moves instantly on submit.
  nomorMobil      String?             @map("nomor_mobil")
  driverName      String?             @map("driver_name")
  recipientName   String?             @map("recipient_name")
  printedAt       DateTime?           @map("printed_at")
  fiscalYearId    String              @map("fiscal_year_id")
  fiscalYear      FiscalYear          @relation("TransferFiscalYear", fields: [fiscalYearId], references: [id])
  createdBy       String              @map("created_by")
  user            User                @relation("TransferCreator", fields: [createdBy], references: [id])
  submittedAt     DateTime?           @map("submitted_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([date])
  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([fiscalYearId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String         @id @default(uuid())
  transferId       String         @map("transfer_id")
  transfer         StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId           String         @map("item_id")
  item             InventoryItem  @relation(fields: [itemId], references: [id])
  quantity         Decimal        @db.Decimal(20, 3)
  description      String?
  // Batch picker for transfers. When set, the source-warehouse Out
  // movement created at submit links back to this inbound batch. The
  // destination-warehouse In movement is a fresh inbound batch.
  sourceMovementId String?        @map("source_movement_id")
  sourceMovement   StockMovement? @relation("TransferBatchSource", fields: [sourceMovementId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([transferId])
  @@index([itemId])
  @@index([sourceMovementId])
  @@map("stock_transfer_items")
}

model StockMovement {
  id                        String              @id @default(uuid())
  movementNumber            String              @unique @map("movement_number")
  date                      DateTime
  itemId                    String              @map("item_id")
  item                      InventoryItem       @relation(fields: [itemId], references: [id])
  warehouseId               String?             @map("warehouse_id")
  warehouse                 Warehouse?          @relation(fields: [warehouseId], references: [id])
  movementType              StockMovementType   @map("movement_type")
  quantity                  Decimal             @db.Decimal(20, 3)
  unitCost                  Decimal             @default(0) @map("unit_cost") @db.Decimal(20, 2)
  totalValue                Decimal             @default(0) @map("total_value") @db.Decimal(20, 2)
  notes                     String?
  referenceType             String?             @map("reference_type")
  referenceId               String?             @map("reference_id")
  referenceNumber           String?             @map("reference_number")
  offsetAccountId           String?             @map("offset_account_id")
  offsetAccount             Account?            @relation("MovementOffset", fields: [offsetAccountId], references: [id])
  journalEntryId            String?             @unique @map("journal_entry_id")
  journalEntry              JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  fiscalYearId              String              @map("fiscal_year_id")
  fiscalYear                FiscalYear          @relation(fields: [fiscalYearId], references: [id])
  createdById               String              @map("created_by_id")
  createdBy                 User                @relation("MovementCreatedBy", fields: [createdById], references: [id])
  isCancelled               Boolean             @default(false) @map("is_cancelled")
  // Loaded HPP per Kg for production-output movements. Includes material +
  // cost components (listrik, buruh, etc.) less by-product NRV. Material-only
  // unit_cost is still used for GL/WAC. unitCostLoaded is informational and
  // drives "loaded margin" reports.
  unitCostLoaded            Decimal?            @map("unit_cost_loaded") @db.Decimal(20, 4)
  // Batch tracking. For outbound movements (Out /
  // AdjustmentOut) this links to the inbound StockMovement (batch) the qty
  // was consumed from. The /items/:id/batches endpoint sums these to compute
  // per-batch availability.
  sourceMovementId          String?             @map("source_movement_id")
  sourceMovement            StockMovement?      @relation("BatchSource", fields: [sourceMovementId], references: [id])
  consumingMovements        StockMovement[]     @relation("BatchSource")
  deliveryOrderItem         DeliveryOrderItem?  @relation("DOLineMovement")
  goodsReceiptItem          GoodsReceiptItem?   @relation("GRLineMovement")
  productionInputBatchUsage ProductionRunItem[] @relation("ProductionInputBatch")
  consumingSalesItems       SalesInvoiceItem[]  @relation("SalesBatchSource")
  consumingTransferItems    StockTransferItem[] @relation("TransferBatchSource")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@index([itemId])
  @@index([warehouseId])
  @@index([date])
  @@index([movementType])
  @@index([fiscalYearId])
  @@map("stock_movements")
}

// Production input draft: no stock/GL/HPP/OEE effect until posted via submitProductionRunInTx
// (directly for bypass roles, else via approval). No FK to ProductionRun/User on purpose.
model ProductionRunDraft {
  id                String    @id @default(uuid())
  draftNumber       String    @unique @map("draft_number")
  date              DateTime
  notes             String?
  warehouseId       String?   @map("warehouse_id")
  // Ringkasan terdenormalisasi utk tampilan daftar.
