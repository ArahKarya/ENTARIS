  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

// Pengajuan Pembayaran (Payment Request)
// Flow: request, supervisor, finance, director (when >= ApprovalRule 'PaymentRequest'), paid
// (JV DR expense or advance / CR cash-bank). settlement*/travel* hold the advance settlement;
// source/sourceRef mark EAM bills. kind/status are TEXT (see services/paymentRequestRules.ts).

model PaymentRequestType {
  id                      String           @id @default(uuid())
  code                    String           @unique
  name                    String
  kind                    String // REIMBURSEMENT | VENDOR_PAYMENT | CASH_ADVANCE | TRAVEL | OTHER
  description             String?
  defaultExpenseAccountId String?          @map("default_expense_account_id")
  defaultExpenseAccount   Account?         @relation("PaymentRequestTypeAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: SetNull)
  requiresAttachment      Boolean          @default(false) @map("requires_attachment")
  requiresSettlement      Boolean          @default(false) @map("requires_settlement")
  isActive                Boolean          @default(true) @map("is_active")
  sortOrder               Int              @default(0) @map("sort_order")
  requests                PaymentRequest[]
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@map("payment_request_types")
}

model PaymentRequest {
  id                   String                     @id @default(uuid())
  number               String                     @unique
  requesterId          String                     @map("requester_id")
  requester            User                       @relation("PaymentRequestRequester", fields: [requesterId], references: [id])
  // Snapshot atasan saat diajukan (perubahan atasan di user tidak memindah antrian).
  supervisorId         String?                    @map("supervisor_id")
  supervisor           User?                      @relation("PaymentRequestSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  typeId               String                     @map("type_id")
  type                 PaymentRequestType         @relation(fields: [typeId], references: [id])
  costCenterId         String?                    @map("cost_center_id")
  costCenter           GaCostCenter?              @relation("PaymentRequestCostCenter", fields: [costCenterId], references: [id], onDelete: SetNull)
  department           String?
  payeeKind            String                     @default("EMPLOYEE") @map("payee_kind") // EMPLOYEE | VENDOR
  partyId              String?                    @map("party_id")
  party                Party?                     @relation("PaymentRequestParty", fields: [partyId], references: [id], onDelete: SetNull)
  payeeName            String                     @map("payee_name")
  bankName             String?                    @map("bank_name")
  bankAccountNo        String?                    @map("bank_account_no")
  bankAccountHolder    String?                    @map("bank_account_holder")
  purpose              String
  neededBy             DateTime?                  @map("needed_by")
  currency             String                     @default("IDR")
  totalAmount          Decimal                    @default(0) @map("total_amount") @db.Decimal(15, 2)
  status               String                     @default("DRAFT")
  // Role direktur yang wajib menyetujui (snapshot ApprovalRule saat verifikasi keuangan).
  directorRole         String?                    @map("director_role")
  submittedAt          DateTime?                  @map("submitted_at")
  supervisorApprovedAt DateTime?                  @map("supervisor_approved_at")
  financeApprovedAt    DateTime?                  @map("finance_approved_at")
  financeApprovedBy    String?                    @map("finance_approved_by")
  directorApprovedAt   DateTime?                  @map("director_approved_at")
  directorApprovedBy   String?                    @map("director_approved_by")
  approvedAt           DateTime?                  @map("approved_at")
  rejectedAt           DateTime?                  @map("rejected_at")
  lastNote             String?                    @map("last_note")
  cancelledAt          DateTime?                  @map("cancelled_at")
  // Pembayaran
  paidAt               DateTime?                  @map("paid_at")
  paidById             String?                    @map("paid_by")
  paidBy               User?                      @relation("PaymentRequestPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paymentDate          DateTime?                  @map("payment_date")
  cashAccountId        String?                    @map("cash_account_id")
  cashAccount          Account?                   @relation("PaymentRequestCashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  journalEntryId       String?                    @unique @map("journal_entry_id")
  journalEntry         JournalEntry?              @relation("PaymentRequestJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  paymentReference     String?                    @map("payment_reference")
  // Perjalanan dinas (type.kind = TRAVEL). "Keperluan" perjalanan = purpose.
  travelDestination    String?                    @map("travel_destination")
  travelStartDate      DateTime?                  @map("travel_start_date")
  travelEndDate        DateTime?                  @map("travel_end_date")
  travelParticipants   String?                    @map("travel_participants")
  // Settlement of a cash advance / business travel (one per request).
  // settlementStatus: null (bukan uang muka / tidak wajib) | OPEN | SUBMITTED |
  // PENDING_FINANCE | REVISION | SETTLED.
  settlementStatus     String?                    @map("settlement_status")
  settledAt            DateTime?                  @map("settled_at")
  settlementJournalId  String?                    @unique @map("settlement_journal_id")
  settlementJournal    JournalEntry?              @relation("PaymentRequestSettlementJournal", fields: [settlementJournalId], references: [id], onDelete: SetNull)
  settlementSupervisorId String?                  @map("settlement_supervisor_id")
  settlementSupervisor User?                      @relation("PaymentRequestSettlementSupervisor", fields: [settlementSupervisorId], references: [id], onDelete: SetNull)
  settlementNote       String?                    @map("settlement_note")
  settlementDeadline   DateTime?                  @map("settlement_deadline")
  settlementSubmittedAt DateTime?                 @map("settlement_submitted_at")
  settlementSupervisorApprovedAt DateTime?        @map("settlement_supervisor_approved_at")
  settlementLastNote   String?                    @map("settlement_last_note")
  settlementDate       DateTime?                  @map("settlement_date")
  settlementRealized   Decimal?                   @map("settlement_realized") @db.Decimal(15, 2)
  settlementCashAccountId String?                 @map("settlement_cash_account_id")
  settlementCashAccount Account?                  @relation("PaymentRequestSettlementCash", fields: [settlementCashAccountId], references: [id], onDelete: SetNull)
  settlementReference  String?                    @map("settlement_reference")
  // Document origin (EAM bills etc.).
  source               String                     @default("MANUAL")
  sourceRef            String?                    @map("source_ref")
  lines                PaymentRequestLine[]
  settlementLines      PaymentRequestSettlementLine[]
  attachments          PaymentRequestAttachment[]
  history              PaymentRequestHistory[]
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  @@index([requesterId])
  @@index([supervisorId])
  @@index([status])
  @@index([typeId])
  @@index([createdAt])
  @@index([source, sourceRef])
  @@index([settlementStatus])
  @@index([settlementSupervisorId])
  @@map("payment_requests")
}

model PaymentRequestLine {
  id               String         @id @default(uuid())
  paymentRequestId String         @map("payment_request_id")
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  lineNo           Int            @default(0) @map("line_no")
  description      String
  amount           Decimal        @db.Decimal(15, 2)
  expenseAccountId String?        @map("expense_account_id")
  expenseAccount   Account?       @relation("PaymentRequestLineAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  costCenterId     String?        @map("cost_center_id")
  costCenter       GaCostCenter?  @relation("PaymentRequestLineCostCenter", fields: [costCenterId], references: [id], onDelete: SetNull)
  expenseDate      DateTime?      @map("expense_date")
  // Perjalanan dinas: kategori + tarif × jumlah (mis. uang saku = tarif × hari). amount tetap total baris.
  category         String?
  quantity         Decimal?       @db.Decimal(12, 2)
  unitAmount       Decimal?       @map("unit_amount") @db.Decimal(15, 2)

  @@index([paymentRequestId])
  @@map("payment_request_lines")
}

// Realisasi pertanggungjawaban uang muka / perjalanan dinas.
model PaymentRequestSettlementLine {
  id               String         @id @default(uuid())
  paymentRequestId String         @map("payment_request_id")
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  lineNo           Int            @default(0) @map("line_no")
  description      String
  expenseDate      DateTime?      @map("expense_date")
  amount           Decimal        @db.Decimal(15, 2)
  category         String?
  // Baris rencana asal (perjalanan dinas) — hanya acuan, tanpa FK.
  plannedLineId    String?        @map("planned_line_id")
  expenseAccountId String?        @map("expense_account_id")
  expenseAccount   Account?       @relation("PaymentRequestSettlementLineAccount", fields: [expenseAccountId], references: [id], onDelete: SetNull)

  @@index([paymentRequestId])
  @@map("payment_request_settlement_lines")
}

model PaymentRequestAttachment {
  id               String         @id @default(uuid())
  paymentRequestId String         @map("payment_request_id")
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  fileName         String         @map("file_name")
  storedName       String         @map("stored_name")
  mimeType         String         @map("mime_type")
  fileSize         Int            @map("file_size")
  filePath         String         @map("file_path")
  uploadedBy       String         @map("uploaded_by")
  // REQUEST (lampiran pengajuan) | SETTLEMENT (bukti pertanggungjawaban)
  scope            String         @default("REQUEST")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([paymentRequestId])
  @@map("payment_request_attachments")
}

model PaymentRequestHistory {
  id               String         @id @default(uuid())
  paymentRequestId String         @map("payment_request_id")
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  action           String // CREATE | UPDATE | SUBMIT | APPROVE | REJECT | RETURN | CANCEL | PAY | CANCEL_PAYMENT | VERIFY | SETTLE_SUBMIT | SETTLE_APPROVE | SETTLE_RETURN | SETTLE_POST | SETTLE_CANCEL
  actorId          String         @map("actor_id")
  actor            User           @relation("PaymentRequestHistoryActor", fields: [actorId], references: [id])
  note             String?
  fromStatus       String?        @map("from_status")
  toStatus         String?        @map("to_status")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([paymentRequestId, createdAt])
  @@map("payment_request_history")
}

// MCP (AIRA)
/// Token servis per profil engine AIRA untuk endpoint /mcp. Token TIDAK disimpan (hanya sha256);
/// signingSecretEnc = secret HMAC (AES-256-GCM) untuk memverifikasi actor assertion.
model McpToken {
  id                 String       @id @default(uuid())
  name               String
  prefix             String
  tokenHash          String       @unique @map("token_hash")
  signingSecretEnc   String       @map("signing_secret_enc")
  defaultActorUserId String?      @map("default_actor_user_id")
  expiresAt          DateTime?    @map("expires_at")
  revokedAt          DateTime?    @map("revoked_at")
  lastUsedAt         DateTime?    @map("last_used_at")
  lastUsedIp         String?      @map("last_used_ip")
  createdById        String       @map("created_by_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  rateLimitPerMin    Int          @default(120) @map("rate_limit_per_min")
  calls              McpCallLog[]
  nonces             McpNonce[]

  @@map("mcp_tokens")
}

/// Riwayat panggilan MCP (satu baris per tools/call). idempotencyKey unik per token (replay).
model McpCallLog {
  id             String   @id @default(uuid())
  tokenId        String   @map("token_id")
  token          McpToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  actorUserId    String?  @map("actor_user_id")
  channel        String?
  tool           String
  risk           String
  argsHash       String   @map("args_hash")
  /// allowed | queued | denied | error | inflight
  decision       String
  httpStatus     Int?     @map("http_status")
  durationMs     Int      @default(0) @map("duration_ms")
  approvalId     String?  @map("approval_id")
  error          String?
  idempotencyKey String?  @map("idempotency_key")
  /// hasil pertama (untuk replay idempotency); hanya diisi bila idempotencyKey ada
  resultJson     Json?    @map("result_json")
  /// `ref` dari actor assertion (panel chat: `<sessionId>:<turnId>`), untuk korelasi panggilan per giliran
  ref            String?
  /// petunjuk kartu hasil (kind/title/href/summary) yang diturunkan dari hasil tool; bukan hasil mentah
  card           Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tokenId, idempotencyKey])
  @@index([ref])
  @@index([createdAt])
  @@index([tool])
  @@index([tokenId])
  @@map("mcp_call_logs")
}

/// Nonce actor assertion yang sudah dipakai (sekali pakai). Disimpan di DB agar atomik
/// (unique insert) lintas replika & tahan restart; dibersihkan terjadwal.
model McpNonce {
  tokenId   String   @map("token_id")
  token     McpToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  nonce     String
  expiresAt DateTime @map("expires_at")

  @@id([tokenId, nonce])
  @@index([expiresAt])
  @@map("mcp_nonces")
}

/// Sesi panel chat AIRA milik satu user. Entaris adalah sumber kebenaran transkrip
/// (engine AIRA tidak menyimpan state yang dibutuhkan untuk melanjutkan).
model ChatSession {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String?
  /// auto | user
  titleSource           String        @default("auto") @map("title_source")
  /// active | archived
  status                String        @default("active")
  /// ringkasan bergulir untuk giliran lama (diperbarui bertahap)
  summary               String?
  /// pesan terakhir (seq) yang sudah tercakup ringkasan
  summaryUpToMessageId  String?       @map("summary_up_to_message_id")
  messageCount          Int           @default(0) @map("message_count")
  lastMessageAt         DateTime      @default(now()) @map("last_message_at")
  /// terakhir dibuka (lintas perangkat): panel membuka sesi ini lebih dulu
  lastOpenedAt          DateTime?     @map("last_opened_at")
  /// giliran yang sedang berjalan (satu per sesi) + waktu mulai (lease)
  inflightTurnId        String?       @map("inflight_turn_id")
  inflightSince         DateTime?     @map("inflight_since")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  messages              ChatMessage[]

  @@index([userId, status, lastMessageAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String           @id @default(uuid())
  /// urutan global monoton (urutan tampil & kursor paging)
  seq           Int              @default(autoincrement())
  sessionId     String           @map("session_id")
  session       ChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnId        String           @map("turn_id")
  /// user | assistant | system
  role          String
  content       String           @default("")
  /// kartu hasil + progres tool + metadata lampiran (snapshot)
  parts         Json?
  /// ok | error | aborted | streaming
  status        String           @default("ok")
  error         String?
  model         String?
  durationMs    Int?             @map("duration_ms")
  /// bukti otoritas yang berlaku pada giliran ini (uid, role, tier, jabatan, hash toolset, versi blok)
  actorSnapshot Json?            @map("actor_snapshot")
  createdAt     DateTime         @default(now()) @map("created_at")
  attachments   ChatAttachment[]

  @@index([sessionId, createdAt])
  @@index([sessionId, seq])
  @@index([turnId])
  /// indeks trigram (pg_trgm) untuk pencarian substring; dibuat oleh migrasi SQL lepas bila ekstensi tersedia
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "chat_messages_content_trgm_idx")
  @@map("chat_messages")
}

model ChatAttachment {
  id        String      @id @default(uuid())
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String      @map("file_name")
  mimeType  String      @map("mime_type")
  size      Int
  filePath  String      @map("file_path")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([messageId])
  @@map("chat_attachments")
}
