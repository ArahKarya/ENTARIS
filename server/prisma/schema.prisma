/// Pola keterangan ternormalisasi -> akun, dipelajari dari koreksi manusia saat posting.
model CashBookLearnedMap {
  id        String   @id @default(uuid())
  pattern   String
  txnType   String   @map("txn_type")
  accountId String   @map("account_id")
  hits      Int      @default(1)
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pattern, txnType])
  @@index([accountId])
  @@map("cash_book_learned_maps")
}

model ProductionRun {
  id                  String                 @id @default(uuid())
  runNumber           String                 @unique @map("run_number")
  date                DateTime
  notes               String?
  referenceType       String?                @map("reference_type")
  referenceId         String?                @map("reference_id")
  referenceNumber     String?                @map("reference_number")
  yieldPct            Decimal?               @map("yield_pct") @db.Decimal(5, 2)
  // Loaded HPP breakdown (informational, computed at submit)
  // totalMaterialCost: sum(input.qty × batchUnitCost) — real from batches
  // totalCostInputSide: sum of input-side cost components (listrik, dll)
  // totalCostOutputSide: sum of output-side cost components (kirim, dll)
  // totalByproductValue: sum(byproduct.qty × nrvUnitValue)
  // computedHpp: (material + costs - byproductValue) / mainOutputQty
  // hppManualOverride: when true, computedHpp was overridden by user
  totalMaterialCost   Decimal?               @map("total_material_cost") @db.Decimal(20, 4)
  totalCostInputSide  Decimal?               @map("total_cost_input_side") @db.Decimal(20, 4)
  totalCostOutputSide Decimal?               @map("total_cost_output_side") @db.Decimal(20, 4)
  totalByproductValue Decimal?               @map("total_byproduct_value") @db.Decimal(20, 4)
  computedHpp         Decimal?               @map("computed_hpp") @db.Decimal(20, 4)
  hppManualOverride   Boolean                @default(false) @map("hpp_manual_override")
  // OEE tracking (Overall Equipment Effectiveness)
  // Semua opsional: run lama / tanpa data OEE tetap valid.
  machineId           String?                @map("machine_id")
  machine             Machine?               @relation("RunMachine", fields: [machineId], references: [id])
  shift               String? // "1" | "2" | "3" (atau Pagi/Siang/Malam)
  shiftLead           String?                @map("shift_lead") // kepala shift (teks bebas)
  manpowerCount       Int?                   @map("manpower_count") // jumlah MP (orang)
  startAt             DateTime?              @map("start_at") // mulai produksi
  endAt               DateTime?              @map("end_at") // selesai produksi
  goodQty             Decimal?               @map("good_qty") @db.Decimal(15, 3) // output good (utk Quality)
  rejectQty           Decimal?               @map("reject_qty") @db.Decimal(15, 3) // afkir/reject
  downtimeMin         Decimal?               @map("downtime_min") @db.Decimal(10, 2) // total downtime (menit)
  availabilityPct     Decimal?               @map("availability_pct") @db.Decimal(5, 2)
  performancePct      Decimal?               @map("performance_pct") @db.Decimal(5, 2)
  qualityPct          Decimal?               @map("quality_pct") @db.Decimal(5, 2)
  oeePct              Decimal?               @map("oee_pct") @db.Decimal(5, 2)
  // Standard shift window (planned production time) and break.
  // plannedMin = (plannedEnd − plannedStart) − (breakEnd − breakStart).
  plannedStart        DateTime?              @map("planned_start")
  plannedEnd          DateTime?              @map("planned_end")
  breakStart          DateTime?              @map("break_start")
  breakEnd            DateTime?              @map("break_end")
  runMachines         ProductionRunMachine[]
  downtimes           ProductionDowntime[]
  items               ProductionRunItem[]
  runCosts            ProductionRunCost[]
  runProcesses        ProductionRunProcess[]
  isCancelled         Boolean                @default(false) @map("is_cancelled")
  fiscalYearId        String                 @map("fiscal_year_id")
  fiscalYear          FiscalYear             @relation(fields: [fiscalYearId], references: [id])
  createdById         String                 @map("created_by_id")
  createdBy           User                   @relation("ProductionCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@index([date])
  @@index([fiscalYearId])
  @@index([machineId])
  @@map("production_runs")
}

// Master mesin produksi — dipakai untuk OEE (kapasitas ideal utk Performance).
model Machine {
  id               String                 @id @default(uuid())
  code             String                 @unique
  name             String
  idealRatePerHour Decimal?               @map("ideal_rate_per_hour") @db.Decimal(15, 3) // kapasitas ideal (kg/jam)
  unit             String                 @default("kg")
  isActive         Boolean                @default(true) @map("is_active")
  notes            String?
  productionRuns   ProductionRun[]        @relation("RunMachine")
  runMachines      ProductionRunMachine[]
  downtimes        ProductionDowntime[]
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("machines")
}

// Event downtime per production run (utk komponen Availability OEE).
model ProductionDowntime {
  id              String        @id @default(uuid())
  productionRunId String        @map("production_run_id")
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  machineId       String?       @map("machine_id")
  machine         Machine?      @relation(fields: [machineId], references: [id])
  category        String // Breakdown | Setup | Material | Lain
  reason          String?
  durationMin     Decimal       @map("duration_min") @db.Decimal(10, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([productionRunId])
  @@index([machineId])
  @@map("production_downtimes")
}

// Machine used in a production run (parallel, own start/stop). OEE is computed per
// machine and stored at submit/edit.
model ProductionRunMachine {
  id              String        @id @default(uuid())
  productionRunId String        @map("production_run_id")
  productionRun   ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  machineId       String        @map("machine_id")
  machine         Machine       @relation(fields: [machineId], references: [id])
  startAt         DateTime?     @map("start_at")
  endAt           DateTime?     @map("end_at")
  runMin          Decimal?      @map("run_min") @db.Decimal(10, 2) // jam jalan efektif (on − istirahat − downtime)
  downtimeMin     Decimal?      @map("downtime_min") @db.Decimal(10, 2)
  allocatedQty    Decimal?      @map("allocated_qty") @db.Decimal(15, 3) // output dialokasi proporsional runMin
  availabilityPct Decimal?      @map("availability_pct") @db.Decimal(5, 2)
  performancePct  Decimal?      @map("performance_pct") @db.Decimal(5, 2)
  qualityPct      Decimal?      @map("quality_pct") @db.Decimal(5, 2)
  oeePct          Decimal?      @map("oee_pct") @db.Decimal(5, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([productionRunId])
  @@index([machineId])
  @@map("production_run_machines")
}

model ProductionRunItem {
  id               String         @id @default(uuid())
  productionRunId  String         @map("production_run_id")
  productionRun    ProductionRun  @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  itemId           String         @map("item_id")
  item             InventoryItem  @relation("ProductionLines", fields: [itemId], references: [id])
  warehouseId      String?        @map("warehouse_id")
  warehouse        Warehouse?     @relation("ProductionLineWarehouse", fields: [warehouseId], references: [id])
  lineType         String         @map("line_type")
  quantity         Decimal        @db.Decimal(15, 3)
  unitPrice        Decimal?       @map("unit_price") @db.Decimal(15, 2)
  yieldPct         Decimal?       @map("yield_pct") @db.Decimal(5, 2)
  isByProduct      Boolean        @default(false) @map("is_by_product")
  // Batch tracking (input side): link to the inbound StockMovement (batch)
  // that the staff picked. batchUnitCost is captured at pick time so the
  // production cost is locked even if WAC changes later.
  sourceMovementId String?        @map("source_movement_id")
  sourceMovement   StockMovement? @relation("ProductionInputBatch", fields: [sourceMovementId], references: [id])
  batchUnitCost    Decimal?       @map("batch_unit_cost") @db.Decimal(20, 4)
  // NRV per Kg for by-product output. Used as unit_cost for the inbound
  // stock movement of that by-product and to compute the loaded HPP of the
  // main output.
  nrvUnitValue     Decimal?       @map("nrv_unit_value") @db.Decimal(20, 4)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([productionRunId])
  @@index([warehouseId])
  @@index([itemId])
  @@index([sourceMovementId])
  @@map("production_run_items")
}

// Master rates for cost components used by production runs. Staff picks a
// standard at run-time and the default rate is prefilled; they can override
// per run if needed (e.g. abnormal electricity bill).
model ProductionCostStandard {
  id            String              @id @default(uuid())
  name          String
  description   String?
  // InputSide: charged per unit of input qty. OutputSide: per unit of main output qty.
  costSide      String              @map("cost_side")
  // InputQty: rate × sum(input qty). OutputQty: rate × main output qty. Fixed: flat per run.
  basis         String
  defaultRate   Decimal             @map("default_rate") @db.Decimal(15, 4)
  // Optional GL account tag (informational; production module does NOT post
  // to this account — real expense still flows via JV / payment / invoice).
  costAccountId String?             @map("cost_account_id")
  costAccount   Account?            @relation("CostStandardAccount", fields: [costAccountId], references: [id])
  // Optional item scope — when set, this standard applies only to runs that
  // produce/consume the linked item. Null = applies to any run.
  itemId        String?             @map("item_id")
  item          InventoryItem?      @relation("ItemCostStandards", fields: [itemId], references: [id])
  // Optional warehouse scope — when set, this standard only appears in
  // production runs at this warehouse (mis. "biaya mesin X" hanya muncul
  // di gudang produksi X). Null = berlaku semua gudang.
  warehouseId   String?             @map("warehouse_id")
  warehouse     Warehouse?          @relation("WarehouseCostStandards", fields: [warehouseId], references: [id])
  isActive      Boolean             @default(true) @map("is_active")
  runCosts      ProductionRunCost[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([costSide])
  @@index([itemId])
  @@index([warehouseId])
  @@map("production_cost_standards")
}

// Cost component used in a specific production run. Snapshot of the master
// rate at submit time (so retroactive master edits don't change historical HPP).
model ProductionRunCost {
  id              String                  @id @default(uuid())
  productionRunId String                  @map("production_run_id")
  productionRun   ProductionRun           @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  standardId      String?                 @map("standard_id")
  standard        ProductionCostStandard? @relation(fields: [standardId], references: [id])
  description     String
  costSide        String                  @map("cost_side")
  basis           String
  rate            Decimal                 @db.Decimal(15, 4)
  qtyBasis        Decimal                 @map("qty_basis") @db.Decimal(15, 3)
  totalAmount     Decimal                 @map("total_amount") @db.Decimal(20, 4)
  costAccountId   String?                 @map("cost_account_id")
  costAccount     Account?                @relation("RunCostAccount", fields: [costAccountId], references: [id])
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([productionRunId])
  @@index([standardId])
  @@map("production_run_costs")
}

// Master list of production processes (Drying, Huller, Polishing, Packing,
// etc.). User-managed. Production runs reference these via the junction
// table production_run_processes for traceability only — no cost or stock
// behavior is tied to a process.
model ProductionProcess {
  id           String                 @id @default(uuid())
  name         String                 @unique
  description  String?
  sortOrder    Int                    @default(0) @map("sort_order")
  isActive     Boolean                @default(true) @map("is_active")
  runProcesses ProductionRunProcess[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("production_processes")
}

// Junction many-to-many: which processes were executed in a given run.
// Backward-compat: rows missing = unspecified (legacy runs).
model ProductionRunProcess {
  id              String            @id @default(uuid())
  productionRunId String            @map("production_run_id")
  productionRun   ProductionRun     @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  processId       String            @map("process_id")
  process         ProductionProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([productionRunId, processId])
  @@index([productionRunId])
  @@index([processId])
  @@map("production_run_processes")
}

enum StockOpnameStatus {
