# === Entaris Server - Environment Variables ===
# Copy this file to .env and fill in the values
#
# Untuk Docker: gunakan .env.docker.example di root project sebagai gantinya.

# PostgreSQL connection string
# Untuk Docker: ganti "localhost" dengan "db" (nama service docker-compose)
DATABASE_URL="postgresql://keuangan:password@localhost:5432/keuangan_db?schema=public"

# Server port
PORT=3001

# JWT Secret (generate with: openssl rand -hex 48)
JWT_SECRET="your-secret-key-here"

# CORS allowed origins (comma-separated)
# For production, add your domain:
# Contoh: http://localhost:5173,https://entaris.yourdomain.com
ALLOWED_ORIGINS="http://localhost:5173"

# Cookie domain for the auth cookie (OPTIONAL, production only). Leave unset for a
# host-only cookie. Set to a parent domain (e.g. ".yourdomain.com") to share the
# session across subdomains (only needed in that case).
# COOKIE_DOMAIN=".yourdomain.com"

# Dev/QA only: skip the login rate limiter (10 attempts / 15 min) so automated
# Playwright runs do not lock out. Ignored when NODE_ENV=production.
# DISABLE_LOGIN_RATE_LIMIT=true
