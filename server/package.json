{
  "private": true,
  "name": "server",
  "version": "4.2.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && node -e \"const fs=require('fs');fs.copyFileSync('src/ai/aira-tool-router.json','dist/ai/aira-tool-router.json');fs.chmodSync('dist/ai/aira-tool-router.json',0o644);if(fs.existsSync('../docs/ai-tools/catalog.json'))fs.copyFileSync('../docs/ai-tools/catalog.json','dist/ai/catalog.json')\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "db:loose": "node prisma/apply-loose-sql.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:prune": "eslint . --prune-suppressions",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ai-tools:inventory": "tsx scripts/ai-tools/inventory-routes.ts",
    "ai-tools:docs": "tsx scripts/ai-tools/generate-docs.ts",
    "ai-tools:check": "tsx scripts/ai-tools/generate-docs.ts --check && vitest run src/ai/__tests__/aiToolsCatalog.test.ts"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@react-pdf/renderer": "^4.3.2",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@types/sharp": "^0.31.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0"
  }
