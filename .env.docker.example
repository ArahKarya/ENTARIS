# ============================================================================
# Entaris — Docker Environment Variables
#
# Copy file ini ke .env sebelum menjalankan docker compose:
#   cp .env.docker.example .env
#   nano .env   # edit JWT_SECRET dan password
# ============================================================================

# === PostgreSQL ===
POSTGRES_USER=keuangan
POSTGRES_PASSWORD=keuangan_secret_2026
POSTGRES_DB=keuangan_db

# === Aplikasi ===
PORT=3001

# JWT Secret — WAJIB diganti untuk production!
# Generate: openssl rand -hex 48
JWT_SECRET=ganti-dengan-secret-yang-aman

# CORS — domain yang diizinkan mengakses API (pisah dengan koma)
# Contoh: http://localhost:3001,https://entaris.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3001

# Base URL publik aplikasi — dipakai utk link "Buka & proses" di notifikasi
# pengajuan (Telegram/in-app). Tanpa trailing slash. Kosongkan utk nonaktif.
APP_BASE_URL=https://entaris.yourdomain.com

# Domain cookie sesi — parent domain bersama untuk SSO shared-cookie antara
# ERP dan EAM (client-eam), mis. .perusahaan-anda.com (perhatikan titik di
# depan). Hanya berlaku saat NODE_ENV=production. Kosongkan = cookie
# host-only (default, cukup untuk satu domain).
# COOKIE_DOMAIN=.perusahaan-anda.com
